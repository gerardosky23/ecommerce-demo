---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import SubpageHero from '../components/common/SubpageHero.astro';

const services = [
  {
    title: 'Consultoría e Implementación Odoo',
    desc: 'Lideramos la implementación integral de Odoo ERP desde el levantamiento de procesos (Gap Analysis) hasta el acompañamiento post go-live.',
    href: '/servicios/consultoria',
    badge: 'Implementación',
    bullets: ['Mapeo de arquitectura de negocio', 'Parametrización modular personalizada', 'Migración segura de datos maestros y saldos'],
    icon: 'briefcase'
  },
  {
    title: 'Desarrollo a Medida & Integraciones API',
    desc: 'Creamos módulos y conectores específicos que extienden las capacidades nativas de Odoo para sincronizar con tu ecosistema tecnológico.',
    href: '/servicios/desarrollo',
    badge: 'Desarrollo',
    bullets: ['Conexión con pasarelas de pago (Niubiz, Izipay, Culqi)', 'Integración con WMS, TMS y plataformas ecommerce', 'Desarrollo de módulos bajo arquitectura Odoo OCA'],
    icon: 'code'
  },
  {
    title: 'Capacitaciones & Adopción de Usuario',
    desc: 'Talleres prácticos orientados a roles (contadores, analistas de compras, jefes de planta, comerciales) para acelerar la curva de adopción.',
    href: '/servicios/capacitaciones',
    badge: 'Capacitaciones',
    bullets: ['Material didáctico y manuales paso a paso', 'Entornos de pruebas (sandbox) para práctica', 'Evaluaciones de competencia funcional'],
    icon: 'graduation'
  },
  {
    title: 'Soporte Continuo & Mesa de Ayuda SLA',
    desc: 'Planes de soporte preventivo y correctivo con tiempos de respuesta garantizados para que tu operación nunca se detenga.',
    href: '/servicios/soporte',
    badge: 'SLA Garantizado',
    bullets: ['Atención directa vía ticket, teléfono y WhatsApp', 'Monitoreo de servidores y bases de datos PostgreSQL', 'Actualizaciones continuas normativas SUNAT'],
    icon: 'headphones'
  },
  {
    title: 'Migración y Rescate de Proyectos Odoo',
    desc: '¿Tienes una implementación inconclusa o una versión antigua? Auditamos la base de datos, corregimos fallos y migramos a versiones modernas de Odoo.',
    href: '/contacto',
    badge: 'Rescate',
    bullets: ['Auditoría profunda de código y dependencias', 'Corrección de asientos descuadrados y Kardex', 'Upgrade de Odoo Community a Enterprise'],
    icon: 'refresh'
  },
  {
    title: 'Asesoría ProInnóvate (Fondos No Reembolsables)',
    desc: 'Estructuramos técnica y económicamente tu postulación a los fondos concursables de digitalización de ProInnóvate Perú.',
    href: '/#proinnovate',
    badge: 'Hasta S/ 50,000',
    bullets: ['Diagnóstico de elegibilidad tributaria y societaria', 'Formulación de la propuesta tecnológica', 'Sustentación de hitos ante el evaluador'],
    icon: 'award'
  }
];
---

<BaseLayout
  title="Servicios de Consultoría e Implementación Odoo · Flexone"
  description="Servicios profesionales de Odoo ERP en Perú: Consultoría, desarrollo a medida, capacitaciones, soporte con SLA y rescate de proyectos."
>
  <Navbar />

  <main id="main">
    <SubpageHero
      title="Servicios Odoo ERP"
      subtitle="Desde la consultoría inicial hasta el soporte de misión crítica para empresas en Perú."
      icon="compass"
    />

    <!-- Services Grid -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white text-brand-dark">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((item) => (
          <article class="p-8 rounded-2xl bg-neutral-50 border border-brand-border flex flex-col justify-between hover:shadow-md hover:border-brand-magenta/30 transition-all">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="text-xs font-semibold text-brand-magenta bg-brand-magenta/10 px-3 py-1 rounded">
                  {item.badge}
                </span>
              </div>

              <h2 class="text-xl font-medium text-brand-dark mb-3">
                {item.title}
              </h2>

              <p class="text-brand-muted text-sm leading-relaxed mb-6 font-light">
                {item.desc}
              </p>

              <ul class="space-y-2 mb-8">
                {item.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-xs text-brand-dark font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta shrink-0 mt-1.5"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-neutral-200">
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-magenta hover:underline"
              >
                <span>Ver detalles del servicio</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Bottom Callout -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-neutral-50 border-t border-brand-border text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-light text-brand-dark mb-4">
          ¿Tienes dudas sobre qué servicio necesita tu empresa?
        </h2>
        <p class="text-brand-muted text-sm font-light mb-8">
          Nuestros consultores evaluarán tus procesos actuales y prepararán una hoja de ruta técnica a tu medida.
        </p>
        <div class="flex items-center justify-center gap-4">
          <a
            href="/contacto"
            class="px-6 py-3 rounded bg-brand-dark text-white text-xs font-semibold uppercase tracking-wider hover:bg-black transition-colors"
          >
            Solicitar diagnóstico sin costo
          </a>
          <a
            href="https://wa.me/51955479055"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded bg-[#25d366]/10 text-emerald-700 border border-[#25d366]/30 text-xs font-semibold hover:bg-[#25d366]/20 transition-colors"
          >
            WhatsApp +51 955 479 055
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
