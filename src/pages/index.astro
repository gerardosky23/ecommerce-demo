---
import '../styles/terrebleu.css';
import StoreApp from '../components/store/StoreApp.svelte';
---

<!doctype html>
<html lang="es" class="bg-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="https://www.terrebleu.ca/cdn/shop/files/Terre_Bleu_REBRAND_ddaec335-2294-4f47-bca4-e71dd6775e7a.svg?v=1738957020" />
    <title>Terre Bleu — Pure Lavender & Botanical Goods</title>
    <meta name="description" content="Maqueta interactiva de ecommerce inspirada en Terre Bleu con inventario y ventas en tiempo real." />
    <meta name="theme-color" content="#ffffff" />

    <!-- Google Fonts: Inter & Playfair Display for Serene Botanical Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <StoreApp client:load />
  </body>
</html>
