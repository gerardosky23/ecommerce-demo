---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import FaqAccordion from '../../components/common/FaqAccordion.svelte';

const kardexFaqs = [
  {
    question: '¿Odoo genera el formato 13.1 de la SUNAT?',
    answer: 'Sí. Con la localización peruana, el registro de inventario permanente valorizado sale como archivo para los libros electrónicos (PLE), en Excel y en PDF. También el formato 12.1 en unidades físicas.'
  },
  {
    question: '¿Qué método de costo usa?',
    answer: 'El método de Costo Promedio Ponderado Móvil (o FIFO / PEPS si la empresa lo requiere), tal como lo exige y reconoce expresamente la SUNAT para el formato 13.1.'
  },
  {
    question: '¿Qué pasa si una factura de flete llega después de vender?',
    answer: 'El módulo de localización peruana permite revalorizar y recalcular el costo medio del periodo afectando automáticamente el costo de ventas de las unidades ya despachadas.'
  },
  {
    question: '¿Cómo sé que el kardex cuadra con la contabilidad?',
    answer: 'Cada movimiento de almacén genera su asiento automático en las cuentas contables de existencias (clase 20, 21, 23, 24, 25, 26). El balance de comprobación mensual coincide al céntimo con el saldo final del kardex.'
  },
  {
    question: '¿Se puede llevar el kardex por lotes o en varios almacenes?',
    answer: 'Sí. El kardex valorizado se desagrega por almacén físico, por lote, número de serie o proyecto, manteniendo la trazabilidad exigida por fiscalizadores.'
  }
];

const steps = [
  {
    num: '1',
    iconPath: 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4',
    title: 'Registrar',
    desc: 'Cada compra, venta, consumo o traslado entra con su motivo (tipo de operación) y el documento que le dio origen.'
  },
  {
    num: '2',
    iconPath: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z',
    title: 'Valorizar',
    desc: 'El costo de cada salida se calcula con el costo promedio, incluso si una factura llegó tarde.'
  },
  {
    num: '3',
    iconPath: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
    title: 'Cerrar',
    desc: 'Lo que no cuadra aparece antes de cerrar, y el mes queda bloqueado con sus saldos.'
  },
  {
    num: '4',
    iconPath: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    title: 'Presentar',
    desc: 'El formato 13.1 sale para el PLE, en Excel y en PDF, listo para la SUNAT o el auditor.'
  }
];
---

<BaseLayout
  title="Kardex valorizado SUNAT Formato 13.1 en Odoo · Flexone"
  description="Kardex valorizado en Odoo: Formato 13.1 PLE, costo promedio ponderado, gastos vinculados de importación y cuadre exacto con contabilidad."
>
  <Navbar />

  <main id="main">
    <!-- Hero Section (Dark #161618) -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Localización Perú · Kardex valorizado</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight mb-6 leading-tight">
          El almacén vale lo que <br class="hidden sm:inline" />
          <span class="font-normal text-brand-magenta">dicen los libros</span>
        </h1>

        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-10 font-light leading-relaxed">
          Cuando el kardex vive en un Excel, nunca coincide con la contabilidad y cada fiscalización se vuelve una búsqueda. Aquí cada entrada y salida se registra con su costo en el momento en que ocurre, y el mes cierra con el almacén y los libros diciendo lo mismo.
        </p>

        <div class="mb-12">
          <a
            href="/contacto"
            class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
          >
            Revisar mi kardex con un especialista ›
          </a>
        </div>

        <!-- Dashboard preview frame -->
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#202124] text-left p-4 sm:p-6 text-xs text-white/80">
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-white">SUNAT PLE 13.1 · Kardex valorizado mensual</span>
            </div>
            <span class="text-white/40">Almacén Central Lurín</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="text-white/40 text-[11px] border-b border-white/10">
                  <th class="pb-2">Producto</th>
                  <th class="pb-2">Unidad</th>
                  <th class="pb-2 text-right">Saldo Inicial</th>
                  <th class="pb-2 text-right">Entradas</th>
                  <th class="pb-2 text-right">Salidas</th>
                  <th class="pb-2 text-right">Saldo Final</th>
                  <th class="pb-2 text-right">Costo Promedio</th>
                  <th class="pb-2 text-right">Valor Total</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 font-mono text-[11px]">
                <tr>
                  <td class="py-2.5 text-white font-sans">Cemento Portland Tipo I</td>
                  <td class="py-2.5 text-white/60 font-sans">BOLSA</td>
                  <td class="py-2.5 text-right">1,200</td>
                  <td class="py-2.5 text-right text-brand-cyan">4,500</td>
                  <td class="py-2.5 text-right text-brand-magenta">3,800</td>
                  <td class="py-2.5 text-right font-bold text-white">1,900</td>
                  <td class="py-2.5 text-right">S/ 26.50</td>
                  <td class="py-2.5 text-right text-emerald-400 font-bold">S/ 50,350.00</td>
                </tr>
                <tr>
                  <td class="py-2.5 text-white font-sans">Fierro corrugado 1/2" x 9m</td>
                  <td class="py-2.5 text-white/60 font-sans">VARILLA</td>
                  <td class="py-2.5 text-right">800</td>
                  <td class="py-2.5 text-right text-brand-cyan">2,000</td>
                  <td class="py-2.5 text-right text-brand-magenta">1,650</td>
                  <td class="py-2.5 text-right font-bold text-white">1,150</td>
                  <td class="py-2.5 text-right">S/ 39.80</td>
                  <td class="py-2.5 text-right text-emerald-400 font-bold">S/ 45,770.00</td>
                </tr>
                <tr>
                  <td class="py-2.5 text-white font-sans">Tubo PVC desagüe 4" x 3m</td>
                  <td class="py-2.5 text-white/60 font-sans">TUBO</td>
                  <td class="py-2.5 text-right">450</td>
                  <td class="py-2.5 text-right text-brand-cyan">1,200</td>
                  <td class="py-2.5 text-right text-brand-magenta">900</td>
                  <td class="py-2.5 text-right font-bold text-white">750</td>
                  <td class="py-2.5 text-right">S/ 18.40</td>
                  <td class="py-2.5 text-right text-emerald-400 font-bold">S/ 13,800.00</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- El mes del almacén en 4 pasos (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            El mes del almacén en <span class="font-normal text-brand-magenta">4 pasos</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          {steps.map((s) => (
            <div class="space-y-3">
              <div class="w-14 h-14 rounded-full bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mx-auto">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={s.iconPath}></path>
                </svg>
              </div>
              <h3 class="font-medium text-base text-brand-dark">{s.num}. {s.title}</h3>
              <p class="text-xs text-brand-muted leading-relaxed font-light">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Del movimiento al libro: Un kardex que no se arma a fin de mes (Dark #202124) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#202124] text-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-cyan mb-2 block">
            Del movimiento al libro
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-white">
            Un kardex que <span class="font-normal text-brand-magenta">no se arma a fin de mes</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-6">
            <span class="px-2.5 py-1 rounded bg-brand-cyan/20 text-brand-cyan text-xs font-semibold tracking-wide uppercase inline-block">
              Valorizar
            </span>
            <h3 class="text-2xl sm:text-3xl font-light text-white">
              El costo correcto, aunque la factura llegue tarde
            </h3>
            <p class="text-white/70 text-sm font-light leading-relaxed">
              La factura del flete o de la aduana suele llegar después de que la mercadería ya se vendió. El costo se recalcula con un clic para todo el mes, cada salida toma el valor correcto y el margen deja de estar inflado.
            </p>
            <ul class="space-y-2 text-xs text-white/70 font-light">
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span><strong>Costo promedio ponderado</strong> por producto y almacén</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Recálculo del mes cuando llegan costos tardíos</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Historial de quién valorizó y cuándo</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Kardex también en dólares</span>
              </li>
            </ul>
          </div>

          <div class="lg:col-span-6 rounded-2xl bg-white/5 border border-white/10 p-6 space-y-4">
            <div class="text-xs font-mono text-brand-cyan">Llegó tarde una factura: el costo se recalcula</div>
            <div class="p-4 rounded-xl bg-black/40 border border-white/10 text-xs font-mono space-y-2">
              <div class="text-white/50 text-[11px]">DUA 118-2026: Cemento Portland Tipo I</div>
              <div class="flex justify-between items-center text-white/70">
                <span>Costo inicial registrado:</span>
                <span>S/ 25.10 / bolsa</span>
              </div>
              <div class="flex justify-between items-center text-white/70">
                <span>Flete tardío prorrateado:</span>
                <span class="text-brand-cyan">+ S/ 1.40 / bolsa</span>
              </div>
              <div class="pt-2 border-t border-white/10 flex justify-between items-center font-bold text-emerald-400">
                <span>Nuevo costo medio revalorizado:</span>
                <span>S/ 26.50 / bolsa</span>
              </div>
            </div>
            <p class="text-[11px] text-white/60 font-light">
              Asiento contable de costo de ventas ajustado automáticamente sin modificar comprobantes pasados.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- El costo real de lo que entra (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5 rounded-2xl bg-neutral-50 border border-neutral-200 p-6 space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-dark">El costo real de lo que se importa</h4>
            <div class="space-y-2 text-xs font-mono">
              <div class="flex justify-between p-2 rounded bg-white border border-neutral-200">
                <span>FOB Proveedor</span>
                <span>$ 18.00</span>
              </div>
              <div class="flex justify-between p-2 rounded bg-white border border-neutral-200">
                <span>Flete marítimo + Seguro</span>
                <span>$ 4.12</span>
              </div>
              <div class="flex justify-between p-2 rounded bg-white border border-neutral-200">
                <span>Ad-valorem & Aduana</span>
                <span>$ 1.08</span>
              </div>
              <div class="flex justify-between p-2 rounded bg-pink-50 border border-pink-200 font-bold text-brand-magenta">
                <span>Costo final en kardex</span>
                <span>$ 23.20</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-6">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              El costo real de <span class="font-normal text-brand-magenta">lo que entra</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Fletes y aduana en el costo</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  Flete, seguro, agente de aduanas y descarga se reparten entre los productos (gastos vinculados, costos en destino), por cantidad o por valor.
                </p>
              </div>
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Importaciones</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  Cada importación (DUA) suma todo lo que costó traerla, en soles y en dólares, antes de fijar el costo del producto.
                </p>
              </div>
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Lo que se fabrica</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  El costo de producción suma materiales, mano de obra y gastos de planta, y entra al kardex como un producto más.
                </p>
              </div>
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Varios almacenes</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  Saldos por almacén, traslados con mercadería en tránsito y consumos internos o mermas con su motivo.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Banner Fiscalización SUNAT 1,500 UIT (Dark #161618) -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-[#161618] text-white">
      <div class="max-w-6xl mx-auto rounded-3xl bg-[#202124] border border-white/10 p-8 sm:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <h2 class="text-2xl sm:text-3xl font-light text-white">
              ¿La empresa vendió más de <br />
              <span class="font-normal text-brand-magenta">S/ 8.25 millones el año pasado?</span>
            </h2>
            <p class="text-white/70 text-sm font-light leading-relaxed">
              Si las ventas del año anterior superan las 1,500 UIT, la SUNAT exige llevar el kardex valorizado en el formato 13.1. Entre 500 y 1,500 UIT (de S/ 2.75 a S/ 8.25 millones) se lleva en unidades físicas. Un kardex armado a mano a fin de año no resiste una fiscalización.
            </p>
            <div class="pt-2">
              <a
                href="/contacto"
                class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
              >
                Conversar sobre mi caso ›
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 p-6 rounded-2xl bg-black/30 border border-white/10 space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-brand-cyan mb-2">Lo que pide la SUNAT</div>
            <ul class="space-y-2 text-xs text-white/70 font-light">
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Cada entrada y salida con su tipo de operación</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Costo unitario y total de cada movimiento</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Saldo en cantidad y en soles</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Método de costo aplicado todo el año</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-cyan">✓</span>
                <span>Relación directa con el libro diario</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Qué cubre el kardex valorizado (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-6">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Qué cubre el <span class="font-normal text-brand-magenta">kardex valorizado</span>
            </h2>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Un ERP básico lleva el stock, pero no sabe del formato 13.1 ni de los tipos de operación de la SUNAT. El kardex de Flexone se apoya en el inventario de Odoo y le agrega lo que exige el Perú: códigos, valorización, cierre mensual y los formatos para presentar.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              El arranque incluye cargar los saldos iniciales por producto, almacén y lote, para que el primer mes ya se valorice en el sistema nuevo.
            </p>
          </div>

          <div class="lg:col-span-6 p-8 rounded-2xl bg-neutral-50 border border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">Incluye</h3>
            <ul class="space-y-3 text-xs text-brand-muted font-light">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Formato 13.1 y 12.1</strong>: PLE, Excel y PDF</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Costo promedio ponderado</strong> con recálculo del mes</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Cierre de kardex</strong> con saldos por periodo</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Gastos vinculados</strong> de compras e importaciones</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Tipos de operación, existencias y unidades SUNAT</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Kardex por <strong>almacén</strong>, por <strong>lote</strong> y en <strong>dólares</strong></span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Asiento de costo de ventas</strong> desde el kardex</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Informe <strong>ABC</strong> de rotación y margen</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Ciclo Completo Section (Light bg #f8f8f8) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-magenta mb-2 block">
            Ciclo completo
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Del almacén al estado de resultados
          </h2>
          <p class="text-sm text-brand-muted max-w-2xl mx-auto mt-4 font-light">
            El costo de ventas es la cifra que más mueve la utilidad. Si sale del kardex, la utilidad del mes es la real y no una estimación.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          <div class="p-6 rounded-2xl bg-white border border-neutral-200 text-center">
            <h4 class="font-medium text-sm text-brand-dark mb-2">Compra o importación</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              La mercadería entra con su costo completo, fletes y aduana incluidos.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-neutral-200 text-center">
