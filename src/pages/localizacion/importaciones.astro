---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import FaqAccordion from '../../components/common/FaqAccordion.svelte';

const importacionesFaqs = [
  {
    question: '¿Odoo suma el flete y la aduana al costo del producto?',
    answer: 'Sí. Con la localización peruana, cada importación tiene su liquidación: se juntan las facturas de flete, seguro, agente de aduanas y transporte, se reparten entre los productos y el costo real llega al kardex valorizado.'
  },
  {
    question: '¿Cómo se reparten los gastos entre varios productos?',
    answer: 'Puedes prorratear los costos vinculados por valor FOB (ideal para seguros o aranceles) o por cantidad/peso/volumen (ideal para fletes marítimos y transporte de carga).'
  },
  {
    question: '¿Se conecta con la aduana o con el agente de aduanas?',
    answer: 'Se registran los datos de la DUA (Declaración Única de Aduanas) con los valores CIF, ad-valorem, IGV y la percepción de aduanas para vincularla directamente al embarque y al registro de compras.'
  },
  {
    question: '¿Qué pasa si una factura de flete llega tarde?',
    answer: 'Se agrega a la liquidación del embarque. El sistema actualiza el costo del producto y calcula automáticamente el ajuste contable necesario en el costo de ventas o inventario.'
  },
  {
    question: '¿Maneja pagos en dólares y anticipos al proveedor?',
    answer: 'Sí. Puedes emitir órdenes en dólares, registrar anticipos al tipo de cambio de la fecha de pago y liquidar el saldo al tipo de cambio de la DUA, generando el asiento por diferencia de cambio automático.'
  }
];

const casos = [
  {
    iconPath: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
    title: 'Un embarque con muchos productos',
    desc: 'Flete y aduana se reparten entre todos, por cantidad o por valor, y cada producto queda con su propio costo.'
  },
  {
    iconPath: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'La factura del flete llega un mes después',
    desc: 'Se agrega a la liquidación, el costo se recalcula y las ventas que ya se hicieron toman el valor correcto.'
  },
  {
    iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    title: 'Un gasto que aún no se factura',
    desc: 'Entra desde su pedido para no esperar; cuando llega la factura, se ajusta.'
  },
  {
    iconPath: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Anticipo ahora y saldo meses después',
    desc: 'Cada pago con su tipo de cambio; la diferencia por el dólar queda registrada sin cálculos a mano.'
  },
  {
    iconPath: 'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0',
    title: 'La primera importación de la empresa',
    desc: 'La aduana cobra una percepción más alta. Queda registrada y se descuenta del IGV, para que ese dinero no se pierda.'
  },
  {
    iconPath: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
    title: 'El mismo producto, comprado aquí y afuera',
    desc: 'El costo promedio mezcla lo nacional y lo importado, cada uno con lo que de verdad costó.'
  }
];
---

<BaseLayout
  title="Costeo real de importaciones en Odoo · Flexone"
  description="Fletes, seguros, aduana y DUA prorrateados al costo real de cada producto en Odoo. Margen verídico y kardex valorizado sin hojas de cálculo."
>
  <Navbar />

  <main id="main">
    <!-- Hero Section (Dark #161618) -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Localización Perú · Importaciones</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight mb-6 leading-tight">
          Lo que cuesta de verdad <br class="hidden sm:inline" />
          <span class="font-normal text-brand-magenta">traer cada producto</span>
        </h1>

        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-10 font-light leading-relaxed">
          Fletes, seguros, aduana y transporte se suman al costo de cada producto importado. El margen que se ve es el real, y el precio de venta se fija sobre lo que de verdad costó.
        </p>

        <div class="mb-12">
          <a
            href="/contacto"
            class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
          >
            Revisar mis importaciones ›
          </a>
        </div>

        <!-- Dashboard preview frame -->
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#202124] text-left p-4 sm:p-6 text-xs text-white/80">
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-white">Liquidación de importación · DUA 118-2026</span>
            </div>
            <span class="text-white/40">Prorrateo de gastos vinculados</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="text-white/40 text-[11px] border-b border-white/10">
                  <th class="pb-2">Producto</th>
                  <th class="pb-2 text-right">Cant.</th>
                  <th class="pb-2 text-right">FOB Unit.</th>
                  <th class="pb-2 text-right">Ad-valorem</th>
                  <th class="pb-2 text-right">Flete & Seg.</th>
                  <th class="pb-2 text-right">Costo Real</th>
                  <th class="pb-2 text-center">Margen</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 font-mono text-[11px]">
                <tr>
                  <td class="py-2.5 text-white font-sans">Taladro percutor 800 W</td>
                  <td class="py-2.5 text-right">250</td>
                  <td class="py-2.5 text-right">$ 18.00</td>
                  <td class="py-2.5 text-right text-white/70">6% ($ 1.08)</td>
                  <td class="py-2.5 text-right text-brand-cyan">$ 4.12</td>
                  <td class="py-2.5 text-right text-emerald-400 font-bold">$ 23.20</td>
                  <td class="py-2.5 text-center"><span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px]">38.2%</span></td>
                </tr>
                <tr>
                  <td class="py-2.5 text-white font-sans">Amoladora angular 4 1/2"</td>
                  <td class="py-2.5 text-right">400</td>
                  <td class="py-2.5 text-right">$ 12.50</td>
                  <td class="py-2.5 text-right text-white/70">6% ($ 0.75)</td>
                  <td class="py-2.5 text-right text-brand-cyan">$ 2.85</td>
                  <td class="py-2.5 text-right text-emerald-400 font-bold">$ 16.10</td>
                  <td class="py-2.5 text-center"><span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px]">42.5%</span></td>
                </tr>
                <tr>
                  <td class="py-2.5 text-white font-sans">Juego de brocas 12 piezas</td>
                  <td class="py-2.5 text-right">1,000</td>
                  <td class="py-2.5 text-right">$ 4.20</td>
                  <td class="py-2.5 text-right text-white/70">0% ($ 0.00)</td>
                  <td class="py-2.5 text-right text-brand-cyan">$ 0.95</td>
                  <td class="py-2.5 text-right text-emerald-400 font-bold">$ 5.15</td>
                  <td class="py-2.5 text-center"><span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px]">51.0%</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- En pocas palabras Box (Light bg #ffffff) -->
    <section class="py-12 px-4 sm:px-6 lg:px-8 bg-white border-b border-neutral-200">
      <div class="max-w-5xl mx-auto rounded-2xl bg-neutral-50 border border-neutral-200/80 p-6 sm:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5 space-y-3">
            <span class="px-2.5 py-1 rounded bg-pink-100 text-brand-magenta text-[11px] font-semibold tracking-wide uppercase inline-block">
              En pocas palabras
            </span>
            <p class="text-sm text-brand-dark leading-relaxed font-light">
              Un taladro que el proveedor chino cobra a <strong>$10</strong> termina costando <strong>$13</strong> cuando llega al almacén. Si el sistema solo ve los $10, la empresa cree que gana más de lo que gana.
            </p>
          </div>
          <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-brand-muted font-light">
            <div class="space-y-1">
              <span class="text-brand-magenta font-bold">✕</span> El flete y la aduana se pagan, pero nadie los suma al producto.
              <br />
              <span class="text-emerald-600 font-bold">✓</span> Cada gasto se reparte entre los productos que trajo ese embarque.
            </div>
            <div class="space-y-1">
              <span class="text-brand-magenta font-bold">✕</span> El IGV de la aduana termina inflando el costo.
              <br />
              <span class="text-emerald-600 font-bold">✓</span> El IGV se usa en la declaración y el costo queda limpio.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Del pedido al costo real (Dark #202124) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#202124] text-white">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <!-- Columna Izquierda -->
          <div class="lg:col-span-5 space-y-6">
            <h2 class="text-3xl sm:text-4xl font-light text-white leading-tight">
              Del pedido al <br />
              <span class="font-normal text-brand-magenta">costo real</span>
            </h2>
            <p class="text-white/70 text-sm font-light leading-relaxed">
              Una importación junta facturas de cinco o seis empresas, en soles y en dólares, que llegan en semanas distintas. Aquí todo cuelga del mismo embarque, así el costo final no depende de un Excel que solo entiende una persona.
            </p>
            <div class="p-5 rounded-2xl bg-white/5 border border-brand-cyan/30 text-xs text-white/80 space-y-2">
              <div class="flex items-center gap-2 text-brand-cyan font-medium">
                <span>📑</span>
                <span>Liquidación de cada importación</span>
              </div>
              <p class="font-light text-white/60 text-[11px] leading-relaxed">
                Un documento por embarque con el costo de cada producto, en soles y en dólares.
              </p>
            </div>
          </div>

          <!-- Columna Derecha: 3 Pasos -->
          <div class="lg:col-span-7 space-y-8">
            <!-- 01 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-4">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-brand-cyan text-[#06222b] font-bold text-xs flex items-center justify-center">01</span>
                <h3 class="text-lg font-medium text-white">Todas las facturas del embarque, juntas</h3>
              </div>
              <p class="text-xs text-white/70 font-light leading-relaxed">
                Naviera, seguro, agente de aduanas y transporte facturan por separado. Todo queda amarrado al mismo embarque y repartido entre sus productos (<strong>gastos vinculados</strong>); lo que aún no se factura entra desde su pedido.
              </p>
              <div class="p-3 rounded-lg bg-black/40 border border-white/10 font-mono text-[11px] text-white/70 flex justify-between items-center">
                <span>Gastos vinculados: Flete ($ 2,400) + Seguro ($ 350) + Aduana ($ 820)</span>
                <span class="text-emerald-400">Prorrateado</span>
              </div>
            </div>

            <!-- 02 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-4">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-brand-cyan text-[#06222b] font-bold text-xs flex items-center justify-center">02</span>
                <h3 class="text-lg font-medium text-white">La DUA, registrada una sola vez</h3>
              </div>
              <p class="text-xs text-white/70 font-light leading-relaxed">
                Con los datos que entrega el agente de aduanas, la <strong>DUA</strong> queda lista: el arancel suma al costo, y el IGV y la percepción pasan a la declaración del mes.
              </p>
              <div class="p-3 rounded-lg bg-black/40 border border-white/10 font-mono text-[11px] text-white/70 flex justify-between items-center">
                <span>DUA Tipo 50: Ad-valorem 6% + IGV 18% + Percepción 3.5%</span>
                <span class="text-emerald-400">Registrada en SIRE</span>
              </div>
            </div>

            <!-- 03 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-4">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-brand-cyan text-[#06222b] font-bold text-xs flex items-center justify-center">03</span>
                <h3 class="text-lg font-medium text-white">Pagos en dólares, cuadrados</h3>
              </div>
              <p class="text-xs text-white/70 font-light leading-relaxed">
                Anticipo y saldo, cada uno con el tipo de cambio de su día. La ganancia o pérdida por el dólar queda registrada sola (<strong>diferencia de cambio</strong>).
              </p>
              <div class="p-3 rounded-lg bg-black/40 border border-white/10 font-mono text-[11px] text-white/70 flex justify-between items-center">
                <span>Anticipo TC: 3.72 · Saldo TC DUA: 3.75 · Diferencia: S/ 115.50</span>
                <span class="text-emerald-400">Cuadrado</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Casos Cubiertos Section (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-magenta mb-2 block">
            Casos cubiertos
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Lo que pasa en cada importación, <span class="font-normal text-brand-magenta">resuelto</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {casos.map((item) => (
            <div class="p-6 rounded-2xl border border-neutral-200/80 bg-neutral-50/50 hover:bg-white hover:shadow-lg hover:border-neutral-300 transition-all flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.iconPath}></path>
                  </svg>
                </div>
                <h3 class="font-medium text-base text-brand-dark mb-2">{item.title}</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 text-center">
          <p class="text-xs text-brand-muted bg-neutral-100/70 inline-flex items-center gap-2 px-4 py-2 rounded-full font-light">
            <svg class="w-4 h-4 text-brand-magenta shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span><strong class="font-medium text-brand-dark">Dato curioso:</strong> desde 2026 el 18% se reparte en 15.5 % de IGV y 2.5 % de Impuesto Municipal, que sube medio punto cada año hasta 2029. El total no cambia.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Pedir afuera con tiempo (Light bg #f8f8f8) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5 rounded-2xl bg-white border border-neutral-200/80 p-6 shadow-md">
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-dark mb-4">Planificación de compras al exterior</h4>
            <div class="space-y-3 font-mono text-[11px]">
              <div class="p-3 rounded-lg bg-neutral-50 border border-neutral-200 flex justify-between items-center">
                <span class="font-sans font-medium text-brand-dark">Taladro percutor</span>
                <span class="text-amber-600">Stock: 25 días</span>
              </div>
              <div class="p-3 rounded-lg bg-neutral-50 border border-neutral-200 flex justify-between items-center">
                <span class="font-sans font-medium text-brand-dark">Tiempo de tránsito</span>
                <span class="text-brand-muted">45 días (marítimo)</span>
              </div>
              <div class="p-3 rounded-lg bg-pink-50 border border-pink-200 flex justify-between items-center text-brand-magenta font-bold">
                <span class="font-sans">Alerta de reposición</span>
                <span>¡Pedir ahora!</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-6">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Pedir afuera <span class="font-normal text-brand-magenta">con tiempo</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Lo que tarda en llegar</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  Cada proveedor tiene su demora de puerta a puerta; los que tardan meses quedan marcados como importación.
                </p>
              </div>
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Para cuántos días alcanza</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  Con el consumo real de los últimos meses, no con una estimación al ojo.
                </p>
              </div>
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Fecha límite para pedir</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  Un aviso llega a tiempo para que la mercadería no se acabe mientras viaja en el contenedor.
                </p>
              </div>
              <div class="space-y-1">
                <h4 class="font-medium text-sm text-brand-dark">Qué importa más</h4>
                <p class="text-xs text-brand-muted font-light leading-relaxed">
                  Los productos se ordenan por rotación (ABC), para no inmovilizar dinero en lo que casi no se vende.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Qué cubre la localización (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-6">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Qué cubre la <span class="font-normal text-brand-magenta">localización</span>
            </h2>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Un ERP básico registra la compra al precio del proveedor y ahí se queda. Aquí el costo de cada producto importado incluye todo lo que costó traerlo, llega al kardex valorizado y la DUA queda lista para la declaración.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              La DUA se registra con los datos que entrega el agente de aduanas, y el embarque se sigue desde el pedido de compra con su fecha prevista de llegada.
            </p>
          </div>

          <div class="lg:col-span-6 p-8 rounded-2xl bg-neutral-50 border border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">Incluye</h3>
            <ul class="space-y-3 text-xs text-brand-muted font-light">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Liquidación de importación</strong> por pedido y embarque</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Reparto de gastos <strong>por cantidad</strong> o <strong>por valor</strong></span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Ad-valorem</strong> por producto</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Costos en <strong>soles y dólares</strong></span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>DUA</strong> en el registro de compras y el SIRE</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Percepción</strong> de importación para la declaración</span>
