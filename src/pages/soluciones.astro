---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import SubpageHero from '../components/common/SubpageHero.astro';

const modules = [
  {
    category: 'Gestión Fiscal & SUNAT',
    title: 'Localización Peruana Integral',
    desc: 'El módulo definitivo para operar en Perú: Facturación Electrónica UBL 2.1, libros electrónicos PLE y SIRE, detracciones SPOT, percepciones y retenciones.',
    href: '/localizacion/contabilidad',
    features: ['Emisión a SUNAT / OSE directa', 'Registro de Ventas (RVIE) y Compras (RCE)', 'Kardex permanente valorizado método promedio']
  },
  {
    category: 'Capital Humano',
    title: 'Planiflex: Planillas y Nóminas',
    desc: 'Gestión completa del ciclo laboral conforme a la normativa del MTPE y SUNAT. Cálculo automatizado de gratificaciones, CTS, vacaciones y liquidaciones.',
    href: '/planiflex',
    features: ['Generación de archivos para PDT Plame', 'Estructuras para T-Registro y AFPnet', 'Portal del empleado con boletas digitales']
  },
  {
    category: 'Logística & Cadena de Suministro',
    title: 'Compras, Inventario e Importaciones',
    desc: 'Control integral de existencias en múltiples almacenes, costeo de importaciones con prorrateo de gastos de aduana y reabastecimiento inteligente.',
    href: '/funcionalidades/compras-inventario',
    features: ['Prorrateo de costos en importaciones (DUA)', 'Trazabilidad por números de serie y lotes', 'Conexión con lectores de código de barra']
  },
  {
    category: 'Tesorería & Banca',
    title: 'Finanzas, Tesorería & Bancos',
    desc: 'Conciliación bancaria automatizada con los principales bancos del Perú (BCP, BBVA, Interbank, Scotiabank), flujo de caja proyectado y telecrédito.',
    href: '/funcionalidades/tesoreria',
    features: ['Carga de extractos bancarios en formato MT940 / CSV', 'Gestión de cobros, cheques y letras en cartera', 'Control analítico por centro de costos']
  },
  {
    category: 'Operaciones de Planta',
    title: 'Manufactura & Producción MRP',
    desc: 'Planificación de requerimientos de materiales, órdenes de producción multinivel, registro de mermas y costeo en tiempo real de mano de obra y maquinaria.',
    href: '/funcionalidades/manufactura',
    features: ['Listas de materiales (BOM) con variantes', 'Programación de centros de trabajo y turnos', 'Costeo real vs estándar de producción']
  },
  {
    category: 'Comercial & Retail',
    title: 'Ventas, CRM & Punto de Venta (POS)',
    desc: 'Acelera el ciclo comercial de tu fuerza de ventas e integra tus tiendas físicas con terminales POS táctiles sincronizados en tiempo real con inventario.',
    href: '/funcionalidades/ventas',
    features: ['Cotizaciones con firma digital y pasarela de pago', 'POS táctil para cajas de retail y restaurantes', 'Segmentación y pipeline de oportunidades CRM']
  }
];
---

<BaseLayout
  title="Soluciones Empresariales Odoo · Flexone"
  description="Catálogo de soluciones ERP Odoo implementadas por Flexone: Localización SUNAT, Planiflex, Inventario, Tesorería, Manufactura y Ventas."
>
  <Navbar />

  <main id="main">
    <SubpageHero
      title="Soluciones Odoo"
      subtitle="Herramientas de gestión integradas diseñadas para la operación real de la empresa en Perú."
      icon="compass"
    />

    <!-- Modules Catalog (Light clean cards) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white text-brand-dark">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {modules.map((m) => (
          <article class="p-8 rounded-2xl bg-neutral-50 border border-brand-border flex flex-col justify-between hover:shadow-md hover:border-brand-magenta/30 transition-all">
            <div>
              <div class="text-xs font-semibold text-brand-magenta bg-brand-magenta/10 px-3 py-1 rounded w-fit mb-5">
                {m.category}
              </div>

              <h2 class="text-xl font-medium text-brand-dark mb-3">
                {m.title}
              </h2>

              <p class="text-brand-muted text-sm leading-relaxed mb-6 font-light">
                {m.desc}
              </p>

              <ul class="space-y-2 mb-8">
                {m.features.map((f) => (
                  <li class="flex items-center gap-2 text-xs text-brand-dark font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta shrink-0"></span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-neutral-200">
              <a
                href={m.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-magenta hover:underline"
              >
                <span>Explorar especificaciones</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Deep Dive Callout -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-neutral-50 border-t border-brand-border text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-light text-brand-dark mb-4">
          ¿Quieres ver cómo funciona en tu rubro?
        </h2>
        <p class="text-brand-muted text-sm font-light mb-8">
          Preparamos una demostración práctica con ejemplos reales de tu sector en una sesión guiada de 30 minutos.
        </p>
        <div class="flex items-center justify-center gap-4">
          <a
            href="/contacto"
            class="px-6 py-3 rounded bg-brand-dark text-white text-xs font-semibold uppercase tracking-wider hover:bg-black transition-colors"
          >
            Pedir demostración guiada
          </a>
          <a
            href="https://wa.me/51955479055"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded bg-[#25d366]/10 text-emerald-700 border border-[#25d366]/30 text-xs font-semibold hover:bg-[#25d366]/20 transition-colors"
          >
            WhatsApp +51 955 479 055
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
