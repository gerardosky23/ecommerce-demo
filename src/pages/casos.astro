---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import SubpageHero from '../components/common/SubpageHero.astro';
import UnderConstructionCard from '../components/common/UnderConstructionCard.astro';
---

<BaseLayout
  title="Casos de éxito · Flexone"
  description="Implementaciones reales de Odoo ERP en Perú, contadas por sector y por problema resuelto."
>
  <Navbar />

  <main id="main">
    <SubpageHero
      title="Casos de éxito"
      subtitle="Implementaciones reales, contadas por sector y por problema resuelto."
      icon="compass"
    />

    <UnderConstructionCard />
  </main>

  <Footer />
</BaseLayout>
