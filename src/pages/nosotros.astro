---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import SubpageHero from '../components/common/SubpageHero.astro';

const corporateValues = [
  {
    title: 'Rigor Técnico & Normativo',
    desc: 'No improvisamos. Cada desarrollo y parametrización se fundamenta en las mejores prácticas de la ingeniería de software y el estricto cumplimiento tributario peruano.'
  },
  {
    title: 'Transparencia Radical',
    desc: 'Estimaciones reales de horas, costos claros de licenciamiento y entregables medibles por cada sprint ágil.'
  },
  {
    title: 'Acompañamiento Cercano',
    desc: 'Entendemos la cultura empresarial peruana. Nuestros consultores están en Lima para brindar soporte presencial o remoto con empatía y rapidez.'
  },
  {
    title: 'Innovación Continua',
    desc: 'Actualizamos proactivamente nuestras soluciones ante cada nueva exigencia tecnológica de SUNAT, SIRE y los avances de la plataforma Odoo a nivel global.'
  }
];
---

<BaseLayout
  title="Sobre Nosotros — Flexxoone S.A.C. · Flexone"
  description="Conoce la trayectoria de Flexone (Flexxoone S.A.C.), Silver Partner de Odoo en Perú. Especialistas en transformación digital y ERP."
>
  <Navbar />

  <main id="main">
    <SubpageHero
      title="Sobre Flexone"
      subtitle="Somos Flexxoone S.A.C., consultora tecnológica e ingenieros de software Silver Partner de Odoo en Perú."
      icon="compass"
    />

    <!-- Misión & Visión -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-white text-brand-dark">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <article class="p-8 sm:p-10 rounded-2xl bg-neutral-50 border border-brand-border space-y-4">
          <div class="w-12 h-12 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h2 class="text-2xl font-light text-brand-dark">Nuestra Misión</h2>
          <p class="text-brand-muted text-sm sm:text-base leading-relaxed font-light">
            Optimizar los procesos de negocio de las empresas peruanas mediante la implementación estratégica y humana de Odoo ERP, integrando la gestión comercial, logística, productiva, contable y tributaria en una plataforma moderna, ágil y escalable.
          </p>
        </article>

        <article class="p-8 sm:p-10 rounded-2xl bg-neutral-50 border border-brand-border space-y-4">
          <div class="w-12 h-12 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h2 class="text-2xl font-light text-brand-dark">Nuestra Visión</h2>
          <p class="text-brand-muted text-sm sm:text-base leading-relaxed font-light">
            Ser reconocidos como el socio tecnológico de referencia en el Perú para la transformación digital empresarial con Odoo, destacados por la excelencia en nuestra localización SUNAT, el módulo laboral Planiflex y la calidez en el servicio.
          </p>
        </article>
      </div>
    </section>

    <!-- Valores Corporativos -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-neutral-50 border-y border-brand-border text-brand-dark">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark mb-4">
            Los valores que guían <span class="font-normal text-brand-magenta">nuestro trabajo</span>
          </h2>
          <p class="text-brand-muted text-base font-light">
            Principios irrenunciables que aseguran el éxito a largo plazo de nuestros clientes.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {corporateValues.map((v) => (
            <article class="p-6 rounded-2xl bg-white border border-brand-border shadow-sm">
              <h3 class="text-lg font-medium text-brand-dark mb-2">{v.title}</h3>
              <p class="text-brand-muted text-xs sm:text-sm leading-relaxed font-light">{v.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Datos Fiscales Transparentes -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-white text-brand-dark">
      <div class="p-8 sm:p-12 rounded-2xl bg-neutral-50 border border-brand-border shadow-sm">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-light text-brand-dark mb-2">Transparencia Corporativa</h2>
          <p class="text-brand-muted text-xs sm:text-sm font-light">
            Información fiscal registrada ante la Superintendencia Nacional de Aduanas y de Administración Tributaria (SUNAT):
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
          <div class="p-4 rounded-xl bg-white border border-neutral-200">
            <div class="text-xs text-brand-muted mb-1 font-light">Razón Social</div>
            <div class="font-medium text-brand-dark text-sm">FLEXXOONE S.A.C.</div>
          </div>
          <div class="p-4 rounded-xl bg-white border border-neutral-200">
            <div class="text-xs text-brand-muted mb-1 font-light">RUC</div>
            <div class="font-mono font-bold text-brand-magenta text-sm">20600995805</div>
          </div>
          <div class="p-4 rounded-xl bg-white border border-neutral-200">
            <div class="text-xs text-brand-muted mb-1 font-light">Condición SUNAT</div>
            <div class="font-medium text-emerald-600 text-sm">ACTIVO / HABIDO</div>
          </div>
          <div class="p-4 rounded-xl bg-white border border-neutral-200">
            <div class="text-xs text-brand-muted mb-1 font-light">Sede Principal</div>
            <div class="font-medium text-brand-dark text-sm">Lima, Perú</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
