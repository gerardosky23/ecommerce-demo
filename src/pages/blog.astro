---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';

const categories = [
  { name: 'Contabilidad y SUNAT', count: 2, iconPath: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { name: 'Facturación electrónica', count: 1, iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { name: 'Inventario, compras e importaciones', count: 1, iconPath: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { name: 'Ventas y tienda en línea', count: 7, iconPath: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z' },
  { name: 'Producción y proyectos', count: 1, iconPath: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { name: 'Odoo y tecnología', count: 8, iconPath: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { name: 'Gestión y transformación digital', count: 8, iconPath: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' },
  { name: 'Noticias de Flexone', count: 1, iconPath: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z' },
];

const articles = [
  {
    slug: 'diferencia-entre-factura-y-boleta',
    title: 'Factura, boleta o nota de crédito: qué comprobante emitir en cada caso según SUNAT',
    category: 'Facturación electrónica',
    date: '6 de octubre de 2026',
    readTime: '6 min de lectura',
    desc: 'Elegir mal un comprobante cuesta dinero. Si emites una boleta a una empresa, tu cliente pierde el crédito fiscal y te pedirá que la anules. Si corriges una factura con otra factura, descuadras tu registro de ventas. En esta guía explicamos la diferencia entre factura y boleta, cuándo corresponde una nota de crédito y cómo evitar los errores que más rechazos generan ante SUNAT.'
  },
  {
    slug: 'el-rol-del-gerente-en-2026-menos-control-mas-estrategia',
    title: 'El rol del gerente en 2026: menos control, más estrategia',
    category: 'Gestión y transformación digital',
    date: '4 de febrero de 2026',
    readTime: '6 min de lectura',
    desc: 'Durante décadas, el rol del gerente estuvo asociado al control: supervisar tareas, validar resultados, autorizar decisiones y asegurar que los procesos se cumplan. Hoy las herramientas digitales asumen el control rutinario para que la dirección se enfoque en la visión estratégica.'
  },
  {
    slug: 'como-se-estan-preparando-las-empresas-para-competir-en-2026',
    title: 'Cómo se están preparando las empresas para competir en 2026',
    category: 'Gestión y transformación digital',
    date: '7 de enero de 2026',
    readTime: '7 min de lectura',
    desc: 'Durante años, hablar del futuro empresarial era un ejercicio de especulación. Hoy ya no lo es. El 2026 se perfila como un punto de quiebre para las empresas que adoptaron digitalización integrada frente a las que continúan gestionando por islas desconectadas.'
  }
];
---

<BaseLayout
  title="Blog de Odoo y Gestión Empresarial en Perú · Flexone"
  description="Artículos sobre Odoo, gestión, tributación SUNAT y tecnología para empresas del Perú: casos, buenas prácticas y novedades."
>
  <Navbar />

  <main id="main">
    <!-- Header Section (Dark #161618) with standardized pt-44 sm:pt-44 lg:pt-48 -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Blog & Conocimiento</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-light text-white tracking-tight mb-4">
          Odoo, gestión y tecnología <br />
          <span class="font-normal text-brand-magenta">para empresas del Perú</span>
        </h1>
        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-8 font-light leading-relaxed">
          Lo que se aprende implementando: procesos, tributación, apps y decisiones con datos.
        </p>

        <!-- Search Input -->
        <div class="max-w-md mx-auto">
          <form action="/blog" method="GET" class="relative">
            <input
              type="text"
              name="q"
              placeholder="Buscar en el blog..."
              class="w-full px-5 py-3 rounded-full bg-[#202226] border border-white/20 text-sm text-white placeholder-white/40 focus:outline-none focus:border-brand-cyan pr-12 shadow-lg"
            />
            <button
              type="submit"
              class="absolute right-1.5 top-1.5 w-9 h-9 rounded-full bg-brand-magenta text-white flex items-center justify-center hover:bg-brand-magenta-dark transition-colors shadow-sm"
              aria-label="Buscar artículos"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- Categories Grid (8 Cards) -->
    <section class="py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h2 class="text-xs font-semibold text-brand-muted uppercase tracking-wider mb-4">Categorías</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
        {categories.map((cat) => (
          <div class="p-4 rounded-xl bg-neutral-50 border border-brand-border text-center hover:border-brand-magenta/40 transition-colors flex flex-col items-center justify-between">
            <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={cat.iconPath}></path>
              </svg>
            </div>
            <div class="text-xs font-medium text-brand-dark leading-tight line-clamp-2 mb-1">{cat.name}</div>
            <div class="text-[10px] text-brand-muted">{cat.count} artículos</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Main Two-Column Layout (Articles + Sidebar) -->
    <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-neutral-100">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Left: Articles List (8 cols) -->
        <div class="lg:col-span-8 space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-neutral-100">
            <h2 class="text-xl font-light text-brand-dark">Artículos</h2>
            <span class="text-xs text-brand-muted">29 artículos</span>
          </div>

          <div class="space-y-6">
            {articles.map((art) => (
              <article class="p-6 sm:p-8 rounded-2xl bg-white border border-brand-border hover:shadow-md transition-shadow">
                <div class="flex flex-wrap items-center gap-3 text-xs text-brand-muted mb-3 font-light">
                  <span class="px-2.5 py-0.5 rounded bg-neutral-100 text-brand-dark font-medium">
                    {art.category}
                  </span>
                  <span>{art.date}</span>
                  <span>·</span>
                  <span>{art.readTime}</span>
                </div>

                <h3 class="text-xl sm:text-2xl font-light text-brand-dark mb-3 leading-snug hover:text-brand-magenta transition-colors">
                  <a href={`/blog/${art.slug}`}>{art.title}</a>
                </h3>

                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-light mb-4">
                  {art.desc}
                </p>

                <div>
                  <a
                    href={`/blog/${art.slug}`}
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-magenta hover:underline"
                  >
                    <span>Leer el artículo</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Right: Sidebar (4 cols) -->
        <aside class="lg:col-span-4 space-y-8" aria-label="Barra lateral del blog">
          <!-- Últimos artículos -->
          <div class="p-6 rounded-2xl bg-neutral-50 border border-brand-border">
            <h3 class="text-sm font-semibold text-brand-dark uppercase tracking-wider mb-4 pb-2 border-b border-neutral-200">
              Últimos artículos
            </h3>
            <div class="space-y-4">
              {articles.map((art) => (
                <div class="space-y-1">
                  <a href={`/blog/${art.slug}`} class="text-xs font-medium text-brand-dark hover:text-brand-magenta transition-colors line-clamp-2">
                    {art.title}
                  </a>
                  <div class="text-[10px] text-brand-muted">{art.date}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Categorías list -->
          <div class="p-6 rounded-2xl bg-neutral-50 border border-brand-border">
            <h3 class="text-sm font-semibold text-brand-dark uppercase tracking-wider mb-4 pb-2 border-b border-neutral-200">
              Categorías
            </h3>
            <ul class="space-y-2 text-xs">
              {categories.map((c) => (
                <li class="flex items-center justify-between text-brand-muted hover:text-brand-dark">
                  <span>{c.name}</span>
                  <span class="font-mono text-neutral-400">{c.count}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Dark CTA Card -->
          <div class="p-6 rounded-2xl bg-[#202124] text-white shadow-lg space-y-4">
            <h3 class="text-lg font-light text-white">¿Odoo para la empresa?</h3>
            <p class="text-xs text-white/70 leading-relaxed font-light">
              Una conversación corta resuelve más que cualquier artículo: qué duele hoy y por dónde conviene empezar.
            </p>
            <a
              href="/contacto"
              class="block w-full py-2.5 rounded bg-brand-magenta text-white text-center text-xs font-semibold uppercase tracking-wider hover:bg-brand-magenta-dark transition-colors"
            >
              Hablemos
            </a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
