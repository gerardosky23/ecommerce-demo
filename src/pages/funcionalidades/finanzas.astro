---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import FaqAccordion from '../../components/common/FaqAccordion.svelte';

const finanzasFaqs = [
  {
    question: '¿El contador puede seguir trabajando con su estudio contable?',
    answer: 'Sí. El estudio entra al sistema con su propio usuario, revisa los asientos y descarga los libros electrónicos sin pedir archivos por correo ni esperar fin de mes.'
  },
  {
    question: '¿Qué pasa con la facturación electrónica que ya tenemos?',
    answer: 'Nos conectamos a tu proveedor actual (Nubefact u otro PSE/OSE) o habilitamos la conexión directa para que sigas emitiendo con tus mismas series sin interrupciones.'
  },
  {
    question: '¿Se puede empezar a mitad de año?',
    answer: 'Sí. Cargamos los balances de comprobación acumulados o los asientos de apertura al mes de corte para arrancar inmediatamente con la contabilidad al día.'
  },
  {
    question: '¿Maneja varias empresas o varias monedas?',
    answer: 'Sí. Soporta multiempresa (con balances consolidados o separados) y multimoneda nativa con tipo de cambio oficial diario de la SUNAT y cálculo de diferencia de cambio.'
  },
  {
    question: '¿Qué tan difícil es el primer cierre?',
    answer: 'Nuestro equipo de especialistas contables te acompaña en el primer cierre mensual guiando la conciliación, el cálculo de impuestos y la generación del PLE/SIRE.'
  }
];

const modules = [
  { name: 'Contabilidad', desc: 'Plan contable peruano, asientos automáticos, conciliación bancaria, cierre y apertura del ejercicio.', iconPath: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { name: 'Facturación', desc: 'Facturas, boletas y notas electrónicas enviadas a la SUNAT, cobranza, letras y anticipos.', iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { name: 'Compras', desc: 'Órdenes de compra, recepción de facturas XML, detracciones y retenciones en el pago al proveedor.', iconPath: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z' },
  { name: 'Inventario', desc: 'Kardex valorizado y costo de ventas integrado a la contabilidad, sin cuadres manuales a fin de mes.', iconPath: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { name: 'Gastos', desc: 'Caja chica, entregas a rendir y rendiciones con foto del comprobante, aprobadas antes de contabilizar.', iconPath: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { name: 'Documentos', desc: 'Comprobantes, contratos y sustentos ordenados por carpeta y vinculados a su asiento.', iconPath: 'M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8m-5 5h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293h3.172a1 1 0 00.707-.293l2.414-2.414a1 1 0 01.707-.293H20' },
  { name: 'Firma electrónica', desc: 'Contratos, actas y conformidades firmados en línea, con registro de quién firmó y cuándo.', iconPath: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' },
  { name: 'Tableros', desc: 'Hojas de cálculo conectadas a los datos: presupuesto contra real, cobranza y flujo de caja.', iconPath: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' }
];
---

<BaseLayout
  title="Finanzas y contabilidad en Odoo · Flexone"
  description="Contabilidad que cuadra, con la SUNAT resuelta. Libros electrónicos PLE, SIRE, detracciones y estados financieros en tiempo real con Odoo ERP."
>
  <Navbar />

  <main id="main">
    <!-- Hero Section (Dark #161618) -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Finanzas y contabilidad</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight mb-6 leading-tight">
          Contabilidad que cuadra, <br class="hidden sm:inline" />
          <span class="font-normal text-brand-magenta">con la SUNAT resuelta</span>
        </h1>

        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-10 font-light leading-relaxed">
          Facturas, compras, bancos y libros electrónicos en un solo sistema. El asiento nace de la operación y el cierre deja de ser una carrera contra el calendario.
        </p>

        <div class="mb-12">
          <a
            href="/contacto"
            class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
          >
            Pedir una demostración ›
          </a>
        </div>

        <!-- Dashboard preview frame -->
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#202124] text-left p-4 sm:p-6 text-xs text-white/80">
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-white">Tablero contable principal · Moneda PEN & USD</span>
            </div>
            <span class="text-white/40">Odoo Contabilidad Perú</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-[11px]">
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-1">
              <div class="font-sans text-white/60">Facturas de clientes</div>
              <div class="text-emerald-400 font-bold text-sm">S/ 126,450.00</div>
              <div class="text-white/40 text-[10px] font-sans">8 por validar · 14 por cobrar</div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-1">
              <div class="font-sans text-white/60">Facturas de proveedores</div>
              <div class="text-brand-magenta font-bold text-sm">S/ 84,200.00</div>
              <div class="text-white/40 text-[10px] font-sans">6 por validar · 11 por pagar</div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-1">
              <div class="font-sans text-white/60">Banco BCP Soles</div>
              <div class="text-brand-cyan font-bold text-sm">S/ 248,630.75</div>
              <div class="text-emerald-400 text-[10px] font-sans">Extracto conciliado al día</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lo que cambia en el día a día (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Lo que cambia en el día a día del <span class="font-normal text-brand-magenta">área contable</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Cierre sin reprocesos</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              Ventas, compras, inventario y planillas generan su asiento al registrarse. El contador revisa en lugar de digitar.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Libros electrónicos listos</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              Diario, mayor, compras, ventas y honorarios salen del sistema. Nada de exportar, limpiar y volver a importar.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Compras sin digitar</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              Las facturas de proveedores entran desde su XML y los datos del proveedor se completan con la consulta RUC.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Estados financieros al día</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              Situación financiera, resultados por función y por naturaleza, flujo de caja y ratios, cuando la gerencia los pida.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Módulos de Odoo para finanzas (Light bg #f8f8f8) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Módulos de Odoo para <span class="font-normal text-brand-magenta">finanzas</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {modules.map((m) => (
            <div class="p-6 rounded-2xl bg-white border border-neutral-200 hover:border-brand-magenta/40 hover:shadow-lg transition-all flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={m.iconPath}></path>
                  </svg>
                </div>
                <h3 class="font-medium text-base text-brand-dark mb-2">{m.name}</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">{m.desc}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-neutral-100">
                <a href="/contacto" class="text-xs font-medium text-brand-magenta hover:underline inline-flex items-center gap-1">
                  Preguntar al asistente →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Localización peruana incluida (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Localización peruana <span class="font-normal text-brand-magenta">incluida</span>
            </h2>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Odoo trae la contabilidad; la normativa peruana la ponemos nosotros. Trabajamos la localización en nuestros propios módulos, probados en empresas de servicios, comercio, manufactura y obra pública.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              La facturación electrónica se conecta con un OSE o PSE como Nubefact, y los libros y reportes se generan con el formato que pide la SUNAT. El tipo de cambio se actualiza solo y cada operación en dólares queda con su diferencia de cambio.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Lo que su operación tenga de particular se configura o se desarrolla a medida, sin salir del estándar de Odoo.
            </p>
          </div>

          <div class="lg:col-span-6 p-8 rounded-2xl bg-neutral-50 border border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">Qué cubre</h3>
            <ul class="space-y-3 text-xs text-brand-muted font-light">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Facturación electrónica con OSE o PSE (Nubefact)</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Libros electrónicos (PLE) y registros para el SIRE</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Detracciones automáticas y pago masivo Banco de la Nación</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Retenciones y percepciones del IGV</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Multimoneda con tipo de cambio SUNAT diario</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Letras, préstamos, leasing y anticipos</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Caja chica y rendiciones de gastos desde celular</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Saldos iniciales y carga masiva de facturas XML</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Ciclo Completo (Light bg #f8f8f8) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-magenta mb-2 block">
            Ciclo completo
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Todas las soluciones terminan aquí
          </h2>
          <p class="text-sm text-brand-muted max-w-2xl mx-auto mt-4 font-light">
            Cada venta, compra, pago, planilla u orden de fabricación deja su asiento en el momento. Contabilidad no digita: revisa, cierra y presenta.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          <div class="p-6 rounded-2xl bg-white border border-neutral-200 text-center">
            <h4 class="font-medium text-sm text-brand-dark mb-2">Registros de compras y ventas</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">Salen solos de las facturas emitidas y recibidas.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-neutral-200 text-center">
            <h4 class="font-medium text-sm text-brand-dark mb-2">Libros contables</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">Cada movimiento enlazado al documento que lo originó.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-neutral-200 text-center">
            <h4 class="font-medium text-sm text-brand-dark mb-2">Inventario valorizado</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">Desde los movimientos del almacén y de la producción.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-neutral-200 text-center">
            <h4 class="font-medium text-sm text-brand-dark mb-2">Estados financieros</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">Al día, sin esperar al cierre del año fiscal.</p>
          </div>
        </div>

        <!-- Se conecta con -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <a href="/funcionalidades/tesoreria" class="p-4 rounded-xl bg-white border border-neutral-200 hover:border-brand-magenta transition-colors flex flex-col items-center">
            <div class="w-8 h-8 rounded-lg bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            </div>
            <span class="text-xs font-medium text-brand-dark block">Tesorería</span>
          </a>
          <a href="/funcionalidades/ventas" class="p-4 rounded-xl bg-white border border-neutral-200 hover:border-brand-magenta transition-colors flex flex-col items-center">
            <div class="w-8 h-8 rounded-lg bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <span class="text-xs font-medium text-brand-dark block">Ventas y CRM</span>
          </a>
          <a href="/funcionalidades/compras-inventario" class="p-4 rounded-xl bg-white border border-neutral-200 hover:border-brand-magenta transition-colors flex flex-col items-center">
            <div class="w-8 h-8 rounded-lg bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </div>
            <span class="text-xs font-medium text-brand-dark block">Compras e inventario</span>
          </a>
          <a href="/funcionalidades/manufactura" class="p-4 rounded-xl bg-white border border-neutral-200 hover:border-brand-magenta transition-colors flex flex-col items-center">
            <div class="w-8 h-8 rounded-lg bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <span class="text-xs font-medium text-brand-dark block">Manufactura</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQs Section (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Preguntas sobre <span class="font-normal text-brand-magenta">finanzas y contabilidad</span>
          </h2>
        </div>

        <FaqAccordion items={finanzasFaqs} client:visible />
      </div>
    </section>

    <!-- ProInnovate Banner (Dark #161618) -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-[#161618] text-white">
      <div class="max-w-6xl mx-auto rounded-3xl bg-[#202124] border border-white/10 p-8 sm:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <span class="px-2.5 py-1 rounded bg-brand-cyan/20 text-brand-cyan text-xs font-semibold tracking-wide uppercase inline-block">
