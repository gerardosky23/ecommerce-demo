---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import FaqAccordion from '../../components/common/FaqAccordion.svelte';

const ventasFaqs = [
  {
    question: '¿Podemos ver el trabajo de cada vendedor?',
    answer: 'Sí. Cada oportunidad tiene responsable, etapa y próxima actividad. Los tableros muestran el embudo, las ventas y el cumplimiento de metas por vendedor o equipo.'
  },
  {
    question: '¿Las consultas de WhatsApp llegan al CRM?',
    answer: 'Sí. Desarrollamos integraciones para que los mensajes de WhatsApp creen leads automáticos en Odoo con el historial de la conversación asignado a un ejecutivo.'
  },
  {
    question: '¿Sirve para empresas que venden al Estado?',
    answer: 'Sí. La oportunidad guarda el número de proceso del SEACE, y al ganar la buena pro el contrato se convierte en un cronograma de entregas con pedidos y facturación periódica.'
  },
  {
    question: '¿Se emiten guías de remisión electrónicas?',
    answer: 'Sí. Desde la orden de venta o el despacho de almacén se generan guías de remisión remitente y transportista validadas ante la SUNAT vía PSE/OSE.'
  },
  {
    question: '¿Podemos traer nuestra cartera de clientes?',
    answer: 'Sí. Migramos tus clientes desde Excel u otro sistema, validando RUC y DNI con la SUNAT para asegurar que los datos fiscales estén limpios desde el día uno.'
  }
];

const modules = [
  { name: 'CRM', desc: 'Embudo por etapas, actividades, pronóstico de ingresos y motivos de pérdida, por vendedor o equipo.', iconPath: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { name: 'Sitio web', desc: 'Formularios y tienda en línea que crean oportunidades y pedidos directamente en el sistema.', iconPath: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
  { name: 'Ventas', desc: 'Cotizaciones, listas de precios, descuentos, pedidos y seguimiento de lo entregado y facturado.', iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { name: 'Punto de venta', desc: 'Caja para tienda o mostrador con boletas y facturas electrónicas, que sigue cobrando sin conexión.', iconPath: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z' },
  { name: 'Firma electrónica', desc: 'Cotizaciones y contratos aceptados en línea, con registro de quién firmó y cuándo.', iconPath: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' },
  { name: 'Inventario', desc: 'Reserva de stock, despacho por almacén y guías de remisión electrónicas.', iconPath: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { name: 'Facturación', desc: 'Factura o boleta electrónica desde el pedido, anticipos, notas de crédito y cobranza.', iconPath: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
  { name: 'Tableros', desc: 'Ventas por vendedor, cliente y producto, embudo y cumplimiento de metas en una sola vista.', iconPath: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' }
];
---

<BaseLayout
  title="Ventas y CRM en Odoo · Flexone"
  description="De la consulta a la cobranza, sin perder el hilo. CRM comercial, cotizaciones, punto de venta y facturación SUNAT en Odoo ERP."
>
  <Navbar />

  <main id="main">
    <!-- Hero Section (Dark #161618) -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Ventas y CRM</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight mb-6 leading-tight">
          De la consulta a la cobranza, <br class="hidden sm:inline" />
          <span class="font-normal text-brand-magenta">sin perder el hilo</span>
        </h1>

        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-10 font-light leading-relaxed">
          Los contactos llegan por la web, WhatsApp o una licitación y siguen el mismo camino: oportunidad, cotización, pedido, guía y factura, sin copiar datos entre sistemas.
        </p>

        <div class="mb-12">
          <a
            href="/contacto"
            class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
          >
            Pedir una demostración ›
          </a>
        </div>

        <!-- CRM Pipeline Mockup -->
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#202124] text-left p-4 sm:p-6 text-xs text-white/80">
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-white">CRM · Embudo de ventas comercial</span>
            </div>
            <span class="text-white/40">Odoo Pipeline</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-2">
              <div class="flex justify-between items-center text-[11px] font-semibold text-white/60">
                <span>NUEVO</span>
                <span>S/ 84,900</span>
              </div>
              <div class="p-2.5 rounded bg-black/40 border border-white/5 text-[11px] space-y-1">
                <div class="font-medium text-white">Cotización fierro Lima</div>
                <div class="text-brand-cyan text-[10px]">Constructora Andina SAC</div>
                <div class="text-white/40 text-[9px]">WhatsApp · S/ 64,900</div>
              </div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-2">
              <div class="flex justify-between items-center text-[11px] font-semibold text-brand-cyan">
                <span>CALIFICADO</span>
                <span>S/ 312,000</span>
              </div>
              <div class="p-2.5 rounded bg-black/40 border border-white/5 text-[11px] space-y-1">
                <div class="font-medium text-white">Licitación de tubería</div>
                <div class="text-brand-cyan text-[10px]">Municipalidad de Ate</div>
                <div class="text-emerald-400 text-[9px]">SEACE · S/ 312,000</div>
              </div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-2">
              <div class="flex justify-between items-center text-[11px] font-semibold text-amber-400">
                <span>PROPUESTA</span>
                <span>S/ 115,000</span>
              </div>
              <div class="p-2.5 rounded bg-black/40 border border-white/5 text-[11px] space-y-1">
                <div class="font-medium text-white">Contrato marco 2026</div>
                <div class="text-brand-cyan text-[10px]">Minera Horizonte</div>
                <div class="text-white/40 text-[9px]">Cotización enviada</div>
              </div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-2">
              <div class="flex justify-between items-center text-[11px] font-semibold text-emerald-400">
                <span>GANADO</span>
                <span>S/ 482,000</span>
              </div>
              <div class="p-2.5 rounded bg-black/40 border border-white/5 text-[11px] space-y-1">
                <div class="font-medium text-white">Entregas programadas 12 meses</div>
                <div class="text-brand-cyan text-[10px]">Ferretería El Maestro</div>
                <div class="text-emerald-400 text-[9px]">En facturación mensual</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cómo se vende con Odoo Section (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-magenta mb-2 block">
            Cómo se vende con Odoo
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Un solo recorrido, desde el <span class="font-normal text-brand-magenta">primer contacto</span>
          </h2>
        </div>

        <div class="space-y-16">
          <!-- 01 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-4">
              <span class="text-sm font-bold text-neutral-400">01</span>
              <h3 class="text-2xl sm:text-3xl font-light text-brand-dark">
                Captar sin perder <span class="font-normal text-brand-magenta">ninguna consulta</span>
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed font-light">
                Una consulta que nadie responde a tiempo es una venta para la competencia. Con cada contacto a la vista y con un responsable, ninguna se queda olvidada en el celular de un vendedor.
              </p>
              <ul class="space-y-2 text-xs text-brand-muted pt-2 font-light">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Formulario web, chat y WhatsApp</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Licitaciones del SEACE con su nomenclatura y fechas</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Llamadas atendidas por agentes de voz con IA</span>
                </li>
              </ul>
            </div>
            <div class="rounded-2xl p-6 bg-pink-50/50 border border-pink-200/60 shadow-md">
              <div class="p-4 rounded-xl bg-white border border-neutral-200 space-y-2">
                <div class="flex justify-between items-center text-xs">
                  <span class="font-medium text-brand-dark">Lead entrante · WhatsApp Business</span>
                  <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-medium">Asignado a: Luis P.</span>
                </div>
                <p class="text-xs text-brand-muted">"Hola, necesitamos cotización de 500 bolsas de cemento con entrega en obra Lurín para mañana."</p>
              </div>
            </div>
          </div>

          <!-- 02 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1 rounded-2xl p-6 bg-cyan-50/50 border border-cyan-200/60 shadow-md">
              <div class="p-4 rounded-xl bg-white border border-neutral-200 space-y-2 font-mono text-xs">
                <div class="flex justify-between text-brand-dark font-sans font-medium">
                  <span>Cotización SO0318 · Mayorista Obra</span>
                  <span class="text-emerald-600">Stock reservado</span>
                </div>
                <div class="text-[11px] text-brand-muted">Total con IGV: <strong>S/ 78,086.96</strong></div>
                <div class="pt-2 text-[10px] text-brand-dark font-sans flex gap-2">
                  <span class="px-2 py-1 rounded bg-neutral-100">Firma electrónica</span>
                  <span class="px-2 py-1 rounded bg-neutral-100">Validez 15 días</span>
                </div>
              </div>
            </div>
            <div class="order-1 lg:order-2 space-y-4">
              <span class="text-sm font-bold text-neutral-400">02</span>
              <h3 class="text-2xl sm:text-3xl font-light text-brand-dark">
                Cotizar con <span class="font-normal text-brand-magenta">precios y stock reales</span>
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed font-light">
                Una cotización con un precio viejo o un producto que no hay termina en reclamo. El vendedor cotiza con la información de hoy y el cliente decide más rápido.
              </p>
              <ul class="space-y-2 text-xs text-brand-muted pt-2 font-light">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Listas de precios y descuentos por grupo</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Cotizaciones en soles o dólares</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Aceptación y firma electrónica del cliente</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 03 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-4">
              <span class="text-sm font-bold text-neutral-400">03</span>
              <h3 class="text-2xl sm:text-3xl font-light text-brand-dark">
                Entregar, facturar y <span class="font-normal text-brand-magenta">cobrar</span>
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed font-light">
                La venta no termina en el pedido, termina cuando se cobra. Despacho, facturación y cobranza trabajan sobre la misma información, sin volver a digitarla ni perder de vista lo pendiente.
              </p>
              <ul class="space-y-2 text-xs text-brand-muted pt-2 font-light">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Guías de remisión remitente y transportista</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Factura o boleta electrónica con anticipos</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Contratos con entregas mensuales programadas</span>
                </li>
              </ul>
            </div>
            <div class="rounded-2xl p-6 bg-neutral-100 border border-neutral-200 shadow-md">
              <div class="p-4 rounded-xl bg-white border border-neutral-200 space-y-2 text-xs">
                <div class="flex justify-between items-center">
                  <span class="font-medium text-brand-dark">Despacho & Facturación SUNAT</span>
                  <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-medium">Aceptado SUNAT</span>
                </div>
                <div class="text-[11px] text-brand-muted">Factura F001-0009131 · Guía T001-0009531</div>
                <div class="text-[11px] text-emerald-600 font-bold">Cobranza al día · Saldo S/ 0.00</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Módulos de Odoo para vender (Light bg #f8f8f8) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Módulos de Odoo para <span class="font-normal text-brand-magenta">vender</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {modules.map((m) => (
            <div class="p-6 rounded-2xl bg-white border border-neutral-200 hover:border-brand-magenta/40 hover:shadow-lg transition-all flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={m.iconPath}></path>
                  </svg>
                </div>
                <h3 class="font-medium text-base text-brand-dark mb-2">{m.name}</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">{m.desc}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-neutral-100">
                <a href="/contacto" class="text-xs font-medium text-brand-magenta hover:underline inline-flex items-center gap-1">
                  Preguntar al asistente →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pensado para vender en el Perú (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Pensado para vender <span class="font-normal text-brand-magenta">en el Perú</span>
            </h2>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Al registrar un cliente basta con su RUC o DNI: el sistema trae la razón social y la dirección. Desde ahí, el comprobante, la guía y la cobranza se hacen dentro de Odoo.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Para quien vende al Estado, la oportunidad guarda el proceso del SEACE, y el contrato adjudicado se convierte en un cronograma de entregas con sus pedidos y su avance.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Las integraciones con WhatsApp y los agentes de voz los desarrollamos nosotros, conectados al CRM de Odoo.
            </p>
          </div>

          <div class="lg:col-span-6 p-8 rounded-2xl bg-neutral-50 border border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">Qué cubre</h3>
            <ul class="space-y-3 text-xs text-brand-muted font-light">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Consulta RUC y DNI al crear clientes</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Guías de remisión electrónicas (Nubefact)</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Boletas y facturas desde el pedido o el punto de venta</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Oportunidades en soles o dólares</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Licitaciones del SEACE en el CRM</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Contratos adjudicados con entregas programadas</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>WhatsApp: mensajes, formularios y respuestas automáticas</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Anticipos y ventas al crédito</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Ok... suena bien, ¿y ahora qué hago? (Next steps 3 cards) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-12 gap-4">
          <div>
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Ok... suena bien, <span class="font-normal text-brand-magenta">¿y ahora qué hago?</span>
            </h2>
          </div>
          <a href="/servicios" class="px-5 py-2.5 rounded-full bg-brand-dark text-white text-xs font-semibold hover:bg-neutral-800 transition-colors">
            Conoce nuestros servicios
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-8 rounded-3xl bg-brand-magenta text-white flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-medium mb-4">Entendemos cómo funciona tu empresa</h3>
              <p class="text-xs text-white/80 font-light leading-relaxed mb-6">
                Conversamos contigo para conocer tus procesos actuales, los problemas que hoy te quitan tiempo y qué esperas mejorar con Odoo.
              </p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-white/20 text-white flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
          </div>

          <div class="p-8 rounded-3xl bg-[#202124] text-white flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-medium mb-4">Configuramos y capacitamos</h3>
              <p class="text-xs text-white/80 font-light leading-relaxed mb-6">
