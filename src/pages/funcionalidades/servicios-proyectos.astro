---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import FaqAccordion from '../../components/common/FaqAccordion.svelte';

const serviciosFaqs = [
  {
    question: '¿El cliente puede ver el avance de su proyecto?',
    answer: 'Sí. Desde el portal web el cliente ve las tareas que se le comparten, el avance porcentual, los documentos y las facturas, sin llamar para preguntar.'
  },
  {
    question: '¿Se puede facturar por avance y no solo por horas?',
    answer: 'Sí. Puedes configurar facturación por hitos acordados en el contrato, por porcentaje de avance valorizado o por horas reales liquidadas.'
  },
  {
    question: '¿Cómo se sabe si un proyecto está ganando o perdiendo plata?',
    answer: 'Mediante cuentas analíticas: cada hora trabajada y cada compra de material o servicio de tercero se carga al proyecto frente al monto facturado al cliente.'
  },
  {
    question: '¿Qué es el control con ruta crítica y curva S?',
    answer: 'Permite visualizar la secuencia de tareas que definen la fecha final del proyecto y comparar el costo y avance real contra la línea base programada.'
  },
  {
    question: '¿Los técnicos en campo pueden usarlo desde el celular?',
    answer: 'Sí. La app de Servicio de Campo permite ver la ruta de visitas, registrar tareas, capturar fotos de evidencia y firmar la conformidad con el cliente en pantalla.'
  }
];

const modules = [
  { name: 'Proyecto', desc: 'Proyectos, tareas, etapas, dependencias, Gantt y portal del cliente.', iconPath: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
  { name: 'Planificación', desc: 'Turnos y asignación del equipo por proyecto, según su disponibilidad.', iconPath: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { name: 'Registro de horas', desc: 'Horas por tarea desde la computadora o el celular, con validación semanal.', iconPath: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { name: 'Mesa de ayuda', desc: 'Tickets con prioridad, plazos de respuesta y encuesta de satisfacción.', iconPath: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z' },
  { name: 'Servicio de campo', desc: 'Visitas técnicas con ruta, firma del cliente y materiales usados.', iconPath: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { name: 'Ventas', desc: 'Cotizaciones de servicios que crean el proyecto y sus hitos al aprobarse.', iconPath: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { name: 'Suscripciones', desc: 'Servicios mensuales con facturación y renovación automáticas.', iconPath: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
  { name: 'Firma electrónica', desc: 'Contratos, actas de conformidad y órdenes de servicio firmadas en línea.', iconPath: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' }
];
---

<BaseLayout
  title="Gestión de proyectos y servicios en Odoo · Flexone"
  description="Proyectos que terminan a tiempo y se cobran completos. Tareas, horas, curva S, valorización y facturación por hitos en Odoo ERP."
>
  <Navbar />

  <main id="main">
    <!-- Hero Section (Dark #161618) -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Servicios y proyectos</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight mb-6 leading-tight">
          Proyectos que terminan a tiempo <br class="hidden sm:inline" />
          <span class="font-normal text-brand-magenta">y se cobran completos</span>
        </h1>

        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-10 font-light leading-relaxed">
          Tareas, horas, avance y facturación en el mismo lugar. Se sabe qué atrasa la entrega antes de que atrase, y cada hora trabajada llega a la factura.
        </p>

        <div class="mb-12">
          <a
            href="/contacto"
            class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
          >
            Pedir una demostración ›
          </a>
        </div>

        <!-- Gantt Mockup -->
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#202124] text-left p-4 sm:p-6 text-xs text-white/80">
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-white">Gantt de Proyecto · Instalación Eléctrica Planta Lurín</span>
            </div>
            <span class="text-white/40">Odoo Projects</span>
          </div>
          <div class="space-y-3 font-mono text-[11px]">
            <div class="flex items-center justify-between p-2 rounded bg-white/5 border border-white/5">
              <span class="font-sans text-white">1. Levantamiento en sitio</span>
              <span class="text-emerald-400">100% completado</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded bg-white/5 border border-white/5">
              <span class="font-sans text-white">2. Ingeniería de detalle</span>
              <span class="text-brand-cyan">75% en curso (Ruta crítica)</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded bg-white/5 border border-white/5">
              <span class="font-sans text-white">3. Compra de tableros y cables</span>
              <span class="text-amber-400">Pendiente de entrega proveedor</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Control de proyectos como en las grandes obras (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Control de proyectos como en las <span class="font-normal text-brand-magenta">grandes obras</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Ruta crítica</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              Qué tareas no pueden atrasarse ni un día y cuánta holgura tiene cada una, calculado solo.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h7"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Línea base</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              El plan aprobado queda congelado y cada cambio se mide contra él, en días y en costo.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Valor ganado (Curva S)</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              Curva S con lo planificado, lo avanzado y lo gastado, y los índices de plazo y costo.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200">
            <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h4 class="font-medium text-sm text-brand-dark mb-2">Riesgo de plazo</h4>
            <p class="text-xs text-brand-muted font-light leading-relaxed">
              Simulación de escenarios para saber qué tan probable es cumplir la fecha comprometida.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Módulos de Odoo para servicios y proyectos (Light bg #f8f8f8) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Módulos de Odoo para <span class="font-normal text-brand-magenta">servicios y proyectos</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {modules.map((m) => (
            <div class="p-6 rounded-2xl bg-white border border-neutral-200 hover:border-brand-magenta/40 hover:shadow-lg transition-all flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={m.iconPath}></path>
                  </svg>
                </div>
                <h3 class="font-medium text-base text-brand-dark mb-2">{m.name}</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">{m.desc}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-neutral-100">
                <a href="/contacto" class="text-xs font-medium text-brand-magenta hover:underline inline-flex items-center gap-1">
                  Preguntar al asistente →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Servicios facturados como pide la SUNAT (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Servicios facturados como <span class="font-normal text-brand-magenta">pide la SUNAT</span>
            </h2>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Un servicio en el Perú casi siempre lleva detracción, a veces anticipos y muchas veces subcontratistas que emiten recibos por honorarios. Si eso se resuelve a mano, el margen del proyecto nunca cuadra.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              En Odoo cada proyecto tiene su cuenta analítica: ahí caen las horas, las compras y los recibos de terceros, y la factura sale con la detracción y el anticipo ya aplicados.
            </p>
          </div>

          <div class="lg:col-span-6 p-8 rounded-2xl bg-neutral-50 border border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">Qué cubre</h3>
            <ul class="space-y-3 text-xs text-brand-muted font-light">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Detracción de servicios calculada en la factura</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Recibos por honorarios con su retención de 4ta</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Anticipos aplicados en cada hito</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Contratos en soles o en dólares</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Costo real por proyecto (cuenta analítica)</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Partes de horas como sustento de la factura</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Actas de conformidad firmadas en línea</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Servicios mensuales facturados solos</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQs Section (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Preguntas sobre <span class="font-normal text-brand-magenta">servicios y proyectos</span>
          </h2>
        </div>

        <FaqAccordion items={serviciosFaqs} client:visible />
      </div>
    </section>

    <!-- ProInnovate Banner (Dark #161618) -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-[#161618] text-white">
      <div class="max-w-6xl mx-auto rounded-3xl bg-[#202124] border border-white/10 p-8 sm:p-12 text-center">
        <span class="px-2.5 py-1 rounded bg-brand-cyan/20 text-brand-cyan text-xs font-semibold tracking-wide uppercase inline-block mb-4">
          ProInnóvate
        </span>
        <h2 class="text-2xl sm:text-3xl font-light text-white mb-4">
          Hasta S/ 50,000 para <span class="font-normal text-brand-magenta">digitalizar tu empresa</span>
        </h2>
        <p class="text-white/70 text-sm font-light max-w-2xl mx-auto mb-8">
          ProInnóvate cofinancia proyectos de digitalización de empresas peruanas. Te acompañamos en todo el proceso, sin costo por la postulación.
        </p>
        <a
          href="/contacto"
          class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
        >
          Quiero postular ›
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
