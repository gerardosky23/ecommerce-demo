---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import FaqAccordion from '../../components/common/FaqAccordion.svelte';

const webFaqs = [
  {
    question: '¿El equipo puede editar la web sin un programador?',
    answer: 'Sí. Textos, imágenes, páginas y productos se cambian desde el editor visual de Odoo. Lo que requiere un diseño nuevo lo desarrollamos como bloques propios que luego se editan igual que los demás.'
  },
  {
    question: '¿Qué medios de pago acepta en el Perú?',
    answer: 'Integramos Mercado Pago, Yape, Plin, Niubiz, Izipay y Culqi para cobrar con tarjetas de crédito/débito en cuotas o billeteras digitales, además de transferencias bancarias y contra entrega.'
  },
  {
    question: '¿Los productos pueden salir en Google Shopping?',
    answer: 'Sí. Odoo genera y actualiza automáticamente el feed XML de productos con precios, stock y fotos para sincronizarlo con Google Merchant Center, Facebook e Instagram Shop.'
  },
  {
    question: '¿La tienda descuenta el stock?',
    answer: 'Sí, de inmediato. Si un cliente compra en línea, el stock se descuenta del almacén asignado para que no haya ventas dobles de un producto que ya no hay en tienda física.'
  },
  {
    question: '¿Se puede usar un tema del mercado o hace falta un diseño propio?',
    answer: 'Ambas opciones son viables. Podemos partir de temas profesionales optimizados (como Theme Prime) o diseñar una interfaz 100% a medida con la identidad de tu marca.'
  }
];

const modules = [
  { name: 'Sitio web', desc: 'Editor visual, varios idiomas y páginas que se adaptan solas, y dominio propio.', iconPath: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
  { name: 'eCommerce', desc: 'Catálogo, variantes, comparador, lista de deseos, carrito, pagos y cuenta del cliente.', iconPath: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
  { name: 'Blog', desc: 'Artículos que atraen visitas desde Google y llevan a los productos.', iconPath: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' },
  { name: 'Citas', desc: 'Reservas en línea con la agenda real del equipo, también dentro de otros sitios.', iconPath: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { name: 'Chat en vivo', desc: 'Conversación con los visitantes y un chatbot que registra oportunidades.', iconPath: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
  { name: 'Inventario', desc: 'Stock en tiempo real en la tienda, retiro en tienda y despacho con guía.', iconPath: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { name: 'Email marketing', desc: 'Boletines y campañas a clientes y suscriptores, con sus resultados.', iconPath: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { name: 'Automatización', desc: 'Secuencias automáticas de bienvenida, seguimiento y recompra.', iconPath: 'M13 10V3L4 14h7v7l9-11h-7z' }
];
---

<BaseLayout
  title="Sitio web y eCommerce integrado en Odoo · Flexone"
  description="Una tienda en línea que no vive aparte. eCommerce sincronizado con inventario, facturación SUNAT y pasarelas peruanas en Odoo ERP."
>
  <Navbar />

  <main id="main">
    <!-- Hero Section (Dark #161618) -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Sitio web y e-commerce</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight mb-6 leading-tight">
          Una tienda en línea <br class="hidden sm:inline" />
          <span class="font-normal text-brand-magenta">que no vive aparte</span>
        </h1>

        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-10 font-light leading-relaxed">
          La web, la tienda y el ERP son el mismo sistema: lo que se vende en línea descuenta stock, sale con su comprobante y llega al CRM; y el equipo cambia la web desde un editor visual, sin programar.
        </p>

        <div class="mb-12">
          <a
            href="/contacto"
            class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
          >
            Pedir una demostración ›
          </a>
        </div>

        <!-- Tienda Mockup -->
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#202124] text-left p-4 sm:p-6 text-xs text-white/80">
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-white">eCommerce Odoo · Tienda de moda y retail</span>
            </div>
            <span class="text-white/40">Sincronizado con Inventario & SUNAT</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-[11px]">
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-1">
              <div class="font-sans text-white/60">Pedidos web hoy</div>
              <div class="text-emerald-400 font-bold text-sm">34 órdenes</div>
              <div class="text-white/40 text-[10px] font-sans">S/ 6,850.00 cobrados</div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-1">
              <div class="font-sans text-white/60">Pasarelas activas</div>
              <div class="text-brand-cyan font-bold text-sm">Mercado Pago & Yape</div>
              <div class="text-emerald-400 text-[10px] font-sans">Boletas automáticas emitidas</div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-1">
              <div class="font-sans text-white/60">Stock sincronizado</div>
              <div class="text-white font-bold text-sm">Almacén Tienda Miraflores</div>
              <div class="text-white/40 text-[10px] font-sans">Despacho en 24h</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- En el celular, donde se compra (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            En el celular, <span class="font-normal text-brand-magenta">donde se compra</span>
          </h2>
          <p class="text-sm text-brand-muted max-w-2xl mx-auto mt-4 font-light">
            La mayoría de las compras empiezan en un celular. Las páginas se adaptan solas, y el editor permite mostrar u ocultar contenido según el dispositivo.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200 space-y-3">
            <div class="w-10 h-10 rounded-full bg-brand-magenta text-white font-bold flex items-center justify-center mx-auto text-sm">
              01
            </div>
            <h3 class="font-medium text-base text-brand-dark">La marca, igual de clara</h3>
            <p class="text-xs text-brand-muted leading-relaxed font-light">
              Una web que convence en la computadora no se rompe en el celular; pierde la venta. Aquí la portada conserva su diseño en cualquier pantalla.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200 space-y-3">
            <div class="w-10 h-10 rounded-full bg-brand-magenta text-white font-bold flex items-center justify-center mx-auto text-sm">
              02
            </div>
            <h3 class="font-medium text-base text-brand-dark">Filtrar sin perderse</h3>
            <p class="text-xs text-brand-muted leading-relaxed font-light">
              Buscar entre cientos de productos en una pantalla chica cansa. Los filtros y el orden quedan a un toque, siempre a mano.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-neutral-50/50 border border-neutral-200 space-y-3">
            <div class="w-10 h-10 rounded-full bg-brand-magenta text-white font-bold flex items-center justify-center mx-auto text-sm">
              03
            </div>
            <h3 class="font-medium text-base text-brand-dark">Elegir y comprar</h3>
            <p class="text-xs text-brand-muted leading-relaxed font-light">
              Si elegir la talla o el color cuesta, el cliente abandona. La ficha muestra lo necesario para decidir y agregar al carrito.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Módulos de Odoo para vender en línea (Light bg #f8f8f8) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Módulos de Odoo para <span class="font-normal text-brand-magenta">vender en línea</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {modules.map((m) => (
            <div class="p-6 rounded-2xl bg-white border border-neutral-200 hover:border-brand-magenta/40 hover:shadow-lg transition-all flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded-xl bg-brand-magenta/10 text-brand-magenta flex items-center justify-center mb-4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={m.iconPath}></path>
                  </svg>
                </div>
                <h3 class="font-medium text-base text-brand-dark mb-2">{m.name}</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">{m.desc}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-neutral-100">
                <a href="/contacto" class="text-xs font-medium text-brand-magenta hover:underline inline-flex items-center gap-1">
                  Preguntar al asistente →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Vender en línea en el Perú (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Vender en línea <span class="font-normal text-brand-magenta">en el Perú</span>
            </h2>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Una tienda peruana necesita más que un carrito: el cliente espera elegir boleta o factura, pagar con tarjeta en soles o saber cuándo le llega el pedido.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Odoo trae Mercado Pago integrado para el Perú, con pago en cuotas. Si la empresa ya trabaja con Niubiz, Izipay o Culqi, la conexión se desarrolla aparte. El comprobante, la guía y el costo de envío salen del mismo pedido.
            </p>
          </div>

          <div class="lg:col-span-6 p-8 rounded-2xl bg-neutral-50 border border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">Qué cubre</h3>
            <ul class="space-y-3 text-xs text-brand-muted font-light">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span><strong>Boleta o factura electrónica</strong> con DNI o RUC</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Mercado Pago en soles, con cuotas</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Transferencias o pago contra entrega</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Precios con IGV incluido</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Retiro en tienda con stock por local</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Guía de remisión para el despacho</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Precios distintos para mayoristas</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Consulta RUC al registrar empresa</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQs Section (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Preguntas sobre la <span class="font-normal text-brand-magenta">web y la tienda en línea</span>
          </h2>
        </div>

        <FaqAccordion items={webFaqs} client:visible />
      </div>
    </section>

    <!-- Bottom Web Design Banner (Dark #161618) -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-[#161618] text-white">
      <div class="max-w-6xl mx-auto rounded-3xl bg-[#202124] border border-white/10 p-8 sm:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <h2 class="text-2xl sm:text-3xl font-light text-white">
              Diseño a medida, <br />
              <span class="font-normal text-brand-magenta">editable desde Odoo</span>
            </h2>
            <p class="text-white/70 text-sm font-light leading-relaxed">
              Cuando las plantillas no alcanzan, diseñamos los bloques, cabeceras y fichas de producto con la identidad de la marca. Quedan dentro del editor de Odoo, listos para que el equipo los use.
            </p>
            <div class="pt-2">
              <a
                href="/contacto"
                class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
              >
                Conversar sobre la web ›
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 p-6 rounded-2xl bg-black/30 border border-white/10 space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-brand-cyan mb-2">Qué se diseña</div>
            <ul class="space-y-2 text-xs text-white/70 font-light">
              <li class="flex items-center gap-2">
                <span class="text-brand-magenta">✓</span>
                <span>Tema con los colores y tipografías de la marca</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-magenta">✓</span>
                <span>Bloques con varios estilos a elegir</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-magenta">✓</span>
                <span>Cabeceras, pies y menús propios</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-magenta">✓</span>
                <span>Fichas de producto y vista rápida</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
