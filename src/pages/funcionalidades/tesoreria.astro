---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import FaqAccordion from '../../components/common/FaqAccordion.svelte';

const tesoreriaFaqs = [
  {
    question: '¿Odoo paga directamente desde el banco?',
    answer: 'Odoo genera el archivo de pago en el formato del banco (BCP, BBVA, Interbank o Scotiabank). Tesorería lo sube a la banca por internet y al conciliar el extracto el pago queda cerrado.'
  },
  {
    question: '¿Cómo se manejan las detracciones?',
    answer: 'Se genera el archivo de pago masivo para el Banco de la Nación. Al subir las constancias, el sistema las asocia a cada factura y libera el crédito fiscal para el registro de compras.'
  },
  {
    question: '¿Se pueden manejar letras de cambio?',
    answer: 'Sí. Puedes emitir letras, enviarlas al banco en cobranza o en descuento, y registrar la amortización o protesto con sus respectivos gastos e intereses.'
  },
  {
    question: '¿Quién aprueba los pagos?',
    answer: 'Se configuran flujos de aprobación por rangos de monto o por área para que ninguna transferencia o cheque se emita sin el visto bueno de gerencia.'
  },
  {
    question: '¿Las rendiciones y la caja chica están incluidas?',
    answer: 'Sí. Los colaboradores fotografían comprobantes desde la app móvil, el sistema lee los datos fiscales y genera la rendición para aprobación de tesorería.'
  }
];

const modules = [
  { name: 'Facturación', desc: 'Cuentas por cobrar, letras, anticipos, notas de crédito y recordatorios de cobranza.', iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { name: 'Contabilidad', desc: 'Bancos, conciliación, diferencia de cambio, préstamos y los asientos de cada movimiento.', iconPath: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { name: 'Compras', desc: 'Facturas de proveedores con su vencimiento, detracción y retención listas para pagar.', iconPath: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z' },
  { name: 'Aprobaciones', desc: 'Pagos, solicitudes de fondos y liquidaciones aprobados por nivel.', iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { name: 'Gastos', desc: 'Entregas a rendir, cajas chicas y reembolsos, con la foto del comprobante desde el celular.', iconPath: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { name: 'Documentos', desc: 'Constancias de detracción, vouchers y extractos guardados junto a cada movimiento.', iconPath: 'M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8m-5 5h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293h3.172a1 1 0 00.707-.293l2.414-2.414a1 1 0 01.707-.293H20' },
  { name: 'Tableros', desc: 'Flujo de caja, posición de bancos, cobranza vencida y pagos de la semana.', iconPath: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' },
  { name: 'Firma electrónica', desc: 'Contratos de préstamo, cartas y acuerdos de pago firmados en línea.', iconPath: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' }
];
---

<BaseLayout
  title="Tesorería y gestión de bancos en Odoo · Flexone"
  description="Cobrar a tiempo, pagar con orden. Flujo de caja, telecrédito bancario BCP/BBVA/Interbank, detracciones y conciliación automática en Odoo."
>
  <Navbar />

  <main id="main">
    <!-- Hero Section (Dark #161618) -->
    <section class="bg-[#161618] text-white pt-44 sm:pt-44 lg:pt-48 pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-cyan text-xs font-medium mb-6">
          <span>Tesorería</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight mb-6 leading-tight">
          Cobrar a tiempo, <br class="hidden sm:inline" />
          <span class="font-normal text-brand-magenta">pagar con orden</span>
        </h1>

        <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-10 font-light leading-relaxed">
          Cuentas por cobrar y por pagar, bancos, letras y rendiciones en el mismo sistema que la contabilidad. Cada movimiento de dinero deja su asiento y el saldo de caja se conoce hoy, no a fin de mes.
        </p>

        <div class="mb-12">
          <a
            href="/contacto"
            class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
          >
            Pedir una demostración ›
          </a>
        </div>

        <!-- Dashboard preview frame -->
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#202124] text-left p-4 sm:p-6 text-xs text-white/80">
          <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="font-medium text-white">Pagos múltiples a proveedores · Archivo Telecrédito</span>
            </div>
            <span class="text-white/40">BCP / BBVA / Interbank</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left font-mono text-[11px]">
              <thead>
                <tr class="text-white/40 border-b border-white/10">
                  <th class="pb-2 font-sans">Proveedor</th>
                  <th class="pb-2 font-sans">Factura</th>
                  <th class="pb-2 font-sans">Banco Destino</th>
                  <th class="pb-2 text-right font-sans">Total</th>
                  <th class="pb-2 text-right font-sans">Detracción SPOT</th>
                  <th class="pb-2 text-right font-sans">Abono Neto</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <tr>
                  <td class="py-2 text-white font-sans">Transportes del Sur SAC</td>
                  <td class="py-2 text-white/70">F001-4812</td>
                  <td class="py-2 text-white/70 font-sans">BCP Corriente</td>
                  <td class="py-2 text-right">S/ 4,500.00</td>
                  <td class="py-2 text-right text-brand-magenta">S/ 180.00</td>
                  <td class="py-2 text-right text-emerald-400 font-bold">S/ 4,320.00</td>
                </tr>
                <tr>
                  <td class="py-2 text-white font-sans">Servicios de Ingeniería Integral</td>
                  <td class="py-2 text-white/70">F001-5190</td>
                  <td class="py-2 text-white/70 font-sans">BBVA Soles</td>
                  <td class="py-2 text-right">S/ 12,800.00</td>
                  <td class="py-2 text-right text-brand-magenta">S/ 1,536.00</td>
                  <td class="py-2 text-right text-emerald-400 font-bold">S/ 11,264.00</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Cómo se mueve el dinero (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-magenta mb-2 block">
            Cómo se mueve el dinero
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Cobrar, pagar y conciliar en el <span class="font-normal text-brand-magenta">mismo sistema</span>
          </h2>
        </div>

        <div class="space-y-16">
          <!-- 01 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-4">
              <span class="text-sm font-bold text-neutral-400">01</span>
              <h3 class="text-2xl sm:text-3xl font-light text-brand-dark">
                Cobrar sin perder de <span class="font-normal text-brand-magenta">vista a nadie</span>
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed font-light">
                La deuda vencida suele descubrirse cuando ya falta caja. Con la cartera ordenada por antigüedad y por vendedor, la cobranza empieza antes de que el cliente se atrase.
              </p>
              <ul class="space-y-2 text-xs text-brand-muted pt-2 font-light">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Antigüedad de saldos por cliente</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Letras en cartera, en descuento y refinanciados</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Anticipos de clientes aplicados a la factura</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Recordatorios de cobranza automáticos</span>
                </li>
              </ul>
            </div>
            <div class="rounded-2xl p-6 bg-pink-50/50 border border-pink-200/60 shadow-md">
              <div class="p-4 rounded-xl bg-white border border-neutral-200 space-y-2 text-xs">
                <div class="flex justify-between items-center">
                  <span class="font-medium text-brand-dark">Reporte de Antigüedad de Deuda</span>
                  <span class="text-brand-magenta font-bold">Total por cobrar: S/ 425,800</span>
                </div>
                <div class="grid grid-cols-3 gap-2 pt-2 text-[10px] text-center font-mono">
                  <div class="p-2 rounded bg-neutral-50 border border-neutral-200">
                    <span class="block text-brand-muted">Corriente</span>
                    <strong class="text-emerald-700">S/ 310,000</strong>
                  </div>
                  <div class="p-2 rounded bg-neutral-50 border border-neutral-200">
                    <span class="block text-brand-muted">1 a 30 días</span>
                    <strong class="text-amber-700">S/ 85,400</strong>
                  </div>
                  <div class="p-2 rounded bg-neutral-50 border border-neutral-200">
                    <span class="block text-brand-muted">&gt; 60 días</span>
                    <strong class="text-rose-700">S/ 30,400</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 02 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1 rounded-2xl p-6 bg-neutral-100 border border-neutral-200 shadow-md">
              <div class="p-4 rounded-xl bg-white border border-neutral-200 space-y-2 text-xs">
                <div class="flex justify-between items-center font-medium text-brand-dark">
                  <span>Lote de Pago Proveedores · BCP</span>
                  <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px]">Archivo generado</span>
                </div>
                <p class="text-[11px] text-brand-muted">18 proveedores seleccionados · Total S/ 154,200.00 con SPOT separado.</p>
              </div>
            </div>
            <div class="order-1 lg:order-2 space-y-4">
              <span class="text-sm font-bold text-neutral-400">02</span>
              <h3 class="text-2xl sm:text-3xl font-light text-brand-dark">
                Pagar en lote, <span class="font-normal text-brand-magenta">con aprobación</span>
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed font-light">
                Pagar a decenas de proveedores deja de ser una mañana de transferencias sueltas y cálculos de detracción en Excel. Se paga lo que toca, cuando toca, y cada pago tiene quién lo aprobó.
              </p>
              <ul class="space-y-2 text-xs text-brand-muted pt-2 font-light">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Pagos múltiples con aprobación por niveles</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Archivo de pago para BCP, BBVA, Interbank y Scotiabank</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Pago masivo de detracciones Banco de la Nación</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Retenciones aplicadas al pagar</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 03 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-4">
              <span class="text-sm font-bold text-neutral-400">03</span>
              <h3 class="text-2xl sm:text-3xl font-light text-brand-dark">
                Conciliar sin <span class="font-normal text-brand-magenta">marcar a mano</span>
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed font-light">
                La conciliación suele quedar para el cierre y es la tarea que más lo retrasa. Con el banco al día, una diferencia se detecta el mismo día en que ocurre y no un mes después.
              </p>
              <ul class="space-y-2 text-xs text-brand-muted pt-2 font-light">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Importación de extractos bancarios</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Conciliación con sugerencias automáticas</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Auxiliar de bancos en soles y en dólares</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                  <span>Diferencia de cambio calculada</span>
                </li>
              </ul>
            </div>
            <div class="rounded-2xl p-6 bg-cyan-50/50 border border-cyan-200/60 shadow-md">
              <div class="p-4 rounded-xl bg-white border border-neutral-200 space-y-2 text-xs">
                <div class="flex justify-between items-center">
                  <span class="font-medium text-brand-dark">Conciliación Bancaria BCP</span>
                  <span class="text-emerald-700 font-bold">100% Emparejado</span>
                </div>
                <div class="text-[11px] text-brand-muted">Extracto bancario cruzado con cobros, facturas y cheques.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Módulos de Odoo para la tesorería (Light bg #f8f8f8) -->
    <section id="rendiciones" class="py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f8f8] text-brand-dark border-t border-neutral-200/60 scroll-mt-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Módulos de Odoo para la <span class="font-normal text-brand-magenta">tesorería</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {modules.map((m) => (
            <div id={m.name === 'Gastos' ? 'rendiciones' : undefined} class="p-6 rounded-2xl bg-white border border-neutral-200 hover:border-brand-magenta/40 hover:shadow-lg transition-all flex flex-col justify-between scroll-mt-24">
              <div>
                <div class="w-10 h-10 rounded-xl bg-brand-cyan/20 text-cyan-800 flex items-center justify-center mb-4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={m.iconPath}></path>
                  </svg>
                </div>
                <h3 class="font-medium text-base text-brand-dark mb-2">{m.name}</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">{m.desc}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-neutral-100">
                <a href="/contacto" class="text-xs font-medium text-brand-magenta hover:underline inline-flex items-center gap-1">
                  Preguntar al asistente →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Lo contable de la tesorería (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-4">
            <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
              Lo contable de la <span class="font-normal text-brand-magenta">tesorería</span>
            </h2>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Cada cobro, pago, transferencia o rendición genera su asiento en el momento, en la cuenta que corresponde. Si hay dólares de por medio, la diferencia de cambio se calcula al pagar y al cierre del mes.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed font-light">
              Las detracciones quedan con su constancia de depósito, las retenciones y percepciones en sus registros, y los libros de caja y bancos salen listos para el PLE.
            </p>
          </div>

          <div class="lg:col-span-6 p-8 rounded-2xl bg-neutral-50 border border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">Qué cubre</h3>
            <ul class="space-y-3 text-xs text-brand-muted font-light">
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Libro caja y bancos para el PLE</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Diferencia de cambio al pagar y al cierre</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Detracciones con su constancia de depósito</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Registro de retenciones y de percepciones</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>ITF y gastos bancarios</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Anticipos de clientes y de proveedores</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Préstamos y leasing con intereses devengados</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-magenta"></span>
                <span>Asientos de rendiciones y cajas chicas</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQs Section (Light bg #ffffff) -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-brand-dark">
            Preguntas sobre <span class="font-normal text-brand-magenta">tesorería</span>
          </h2>
        </div>

        <FaqAccordion items={tesoreriaFaqs} client:visible />
      </div>
    </section>

    <!-- Bottom Bank Integration Banner (Dark #161618) -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-[#161618] text-white">
      <div class="max-w-6xl mx-auto rounded-3xl bg-[#202124] border border-white/10 p-8 sm:p-12 text-center">
        <h2 class="text-2xl sm:text-3xl font-light text-white mb-4">
          Conectamos Odoo con <span class="font-normal text-brand-magenta">tus bancos</span>
        </h2>
        <p class="text-white/70 text-sm font-light max-w-2xl mx-auto mb-8">
          La tesorería rinde cuando el banco y el sistema hablan el mismo idioma. Configuramos los archivos de pago, la importación de extractos y las cuentas de cada proveedor desde el arranque.
        </p>
        <div class="flex flex-wrap justify-center gap-6 text-sm font-medium text-brand-cyan mb-8">
          <span class="px-4 py-2 rounded-xl bg-white/5 border border-white/10">BCP</span>
          <span class="px-4 py-2 rounded-xl bg-white/5 border border-white/10">BBVA</span>
          <span class="px-4 py-2 rounded-xl bg-white/5 border border-white/10">Interbank</span>
          <span class="px-4 py-2 rounded-xl bg-white/5 border border-white/10">Scotiabank</span>
          <span class="px-4 py-2 rounded-xl bg-brand-magenta/20 text-white border border-brand-magenta/30">Banco de la Nación (SPOT)</span>
        </div>
        <a
          href="/contacto"
          class="inline-block px-6 py-3 rounded-full bg-brand-cyan text-[#06222b] text-xs font-bold uppercase tracking-wider hover:bg-cyan-300 transition-colors shadow-lg"
        >
          Hablar con un especialista ›
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
