---
import '../styles/terrebleu.css';
import CatalogView from '../components/store/CatalogView.svelte';
---

<!doctype html>
<html lang="es" class="bg-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <title>Tienda & Catálogo de Productos — Terre Bleu</title>
    <meta name="description" content="Explora nuestra colección completa de lavanda orgánica, aceites esenciales y sets botánicos." />
    <meta name="theme-color" content="#ffffff" />

    <!-- Google Fonts: Inter & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <CatalogView client:load />
  </body>
</html>
