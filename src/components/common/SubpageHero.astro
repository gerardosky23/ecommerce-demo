---
interface Props {
  tag?: string;
  title: string;
  subtitle: string;
  icon?: string;
}

const { tag, title, subtitle, icon = 'code' } = Astro.props;
---

<section class="bg-[#191b1d] text-white pt-44 sm:pt-44 lg:pt-48 pb-16 lg:pb-20 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden" data-bs-theme="dark">
  <div class="max-w-4xl mx-auto relative z-10">
    <!-- Icon circle matching bg-primary bg-opacity-10 text-primary -->
    <div class="w-14 h-14 rounded-full bg-brand-magenta/15 text-brand-magenta flex items-center justify-center mx-auto mb-5 text-2xl border border-brand-magenta/20 shadow-inner">
      {icon === 'code' && (
        <svg class="w-7 h-7 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>
      )}
      {icon === 'compass' && (
        <svg class="w-7 h-7 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
        </svg>
      )}
      {icon === 'mortarboard' && (
        <svg class="w-7 h-7 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
          <path d="M6 12v5c3 3 9 3 12 0v-5"/>
        </svg>
      )}
      {icon === 'life-preserver' && (
        <svg class="w-7 h-7 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <circle cx="12" cy="12" r="4"/>
          <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/>
          <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/>
          <line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/>
          <line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>
        </svg>
      )}
    </div>

    {tag && (
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-magenta text-xs font-medium mb-4">
        <span>{tag}</span>
      </div>
    )}

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white tracking-tight mb-3">
      {title}
    </h1>

    <p class="text-white/80 text-base sm:text-lg max-w-2xl mx-auto font-light leading-relaxed">
      {subtitle}
    </p>
  </div>
</section>
