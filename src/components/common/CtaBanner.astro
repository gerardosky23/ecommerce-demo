---
interface Props {
  title?: string;
  description?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  badge?: string;
}

const {
  title = "Transforma la gestión de tu empresa con Odoo ERP",
  description = "Agenda un diagnóstico gratuito con nuestros consultores senior y descubre cómo automatizar tu contabilidad SUNAT, inventario y planillas.",
  primaryCtaText = "Solicitar Diagnóstico Sin Costo",
  primaryCtaHref = "/contacto",
  secondaryCtaText = "Chatear por WhatsApp",
  secondaryCtaHref = "https://wa.me/51955479055",
  badge = "Silver Partner Odoo Perú"
} = Astro.props;
---

<section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-brand-primary via-[#0f1d3a] to-surface-card border border-white/10 p-8 sm:p-12 lg:p-16 text-center shadow-2xl">
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-brand-cyan/20 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 max-w-3xl mx-auto space-y-6">
      {badge && (
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 text-xs font-semibold text-brand-cyan">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan"></span>
          <span>{badge}</span>
        </div>
      )}

      <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-white tracking-tight">
        {title}
      </h2>

      <p class="text-ink-soft text-sm sm:text-base leading-relaxed">
        {description}
      </p>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={primaryCtaHref} class="btn btn-primary text-sm py-3.5 px-7 w-full sm:w-auto shadow-lg hover:shadow-brand-accent/40">
          <span>{primaryCtaText}</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 ml-1">
            <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <a href={secondaryCtaHref} target="_blank" rel="noopener noreferrer" class="btn btn-outline text-sm py-3.5 px-6 w-full sm:w-auto text-emerald-300 border-emerald-500/30 hover:bg-emerald-500/10 flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>{secondaryCtaText}</span>
        </a>
      </div>
    </div>
  </div>
</section>
