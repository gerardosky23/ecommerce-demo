---
const currentYear = 2026;

const soluciones = [
  { name: 'Finanzas y contabilidad', href: '/funcionalidades/finanzas' },
  { name: 'Tesorería', href: '/funcionalidades/tesoreria' },
  { name: 'Ventas y CRM', href: '/funcionalidades/ventas' },
  { name: 'Compras e inventario', href: '/funcionalidades/compras-inventario' },
  { name: 'Manufactura', href: '/funcionalidades/manufactura' },
  { name: 'RR. HH., asistencias y reclutamiento', href: '/funcionalidades/rrhh' },
  { name: 'Sitio web y e-commerce', href: '/funcionalidades/sitio-web' },
  { name: 'Servicios y proyectos', href: '/funcionalidades/servicios-proyectos' },
];

const industrias = [
  'Obras públicas',
  'Turismo y transporte',
  'Plásticos y empaque',
  'Sector público',
  'Salud',
  'Laboratorios',
  'Minería',
  'Logística y flotas',
  'Moda y e-commerce',
];

const servicios = [
  { name: 'Desarrollo a medida', href: '/servicios/desarrollo' },
  { name: 'Apps móviles', href: '/servicios/desarrollo' },
  { name: 'Implementación', href: '/servicios/implementacion' },
  { name: 'Consultoría', href: '/servicios/consultoria' },
  { name: 'Capacitaciones', href: '/servicios/capacitaciones' },
  { name: 'Soporte', href: '/servicios/soporte' },
  { name: 'Casos de éxito', href: '/casos' },
  { name: 'Blog', href: '/blog' },
  { name: 'Financiamiento Pro Innóvate', href: '/#proinnovate' },
  { name: 'Preguntas frecuentes', href: '/#preguntas' },
];
---

<footer class="bg-[#202124] text-white/70 text-sm pt-16 pb-8 border-t border-white/10 relative overflow-hidden" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Pie de página Flexone</h2>

  <!-- Background decorative wave pattern from Flexone asset -->
  <div class="absolute left-0 bottom-0 pointer-events-none opacity-10 select-none">
    <img src="/images/flexone/decoracion/patron-pie.svg" alt="" class="w-96 h-auto" />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 mb-16">
      <!-- Columna 1: Brand & Misión -->
      <div class="lg:col-span-1 space-y-4">
        <a href="/" class="inline-block mb-2" aria-label="Flexone inicio">
          <img
            data-brand="logo"
            data-brand-variant="dark"
            src="/images/flexone/logo-negativo-480.webp"
            alt="Flexone"
            width="130"
            height="34"
            class="h-8 w-auto max-w-[180px] object-contain"
          />
        </a>
        <p data-content="footer-about" class="text-xs text-white/60 leading-relaxed">
          Implementación de Odoo para empresas del Perú: finanzas con localización, operaciones, personal y desarrollo a medida.
        </p>
        <a href="/contacto" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-cyan hover:underline pt-2">
          <span>Hablemos</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <!-- Columna 2: Soluciones -->
      <div>
        <h3 class="font-medium text-white text-sm mb-4">Soluciones</h3>
        <ul class="space-y-2 text-xs">
          {soluciones.map((s) => (
            <li>
              <a href={s.href} class="hover:text-white transition-colors">{s.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Industrias -->
      <div>
        <h3 class="font-medium text-white text-sm mb-4">Industrias</h3>
        <ul class="space-y-2 text-xs">
          {industrias.map((ind) => (
            <li>
              <a href="/industrias" class="hover:text-white transition-colors">{ind}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Servicios -->
      <div>
        <h3 class="font-medium text-white text-sm mb-4">Servicios</h3>
        <ul class="space-y-2 text-xs">
          {servicios.map((s) => (
            <li>
              <a href={s.href} class="hover:text-white transition-colors">{s.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 5: Contacto & Redes -->
      <div>
        <h3 class="font-medium text-white text-sm mb-4">Contacto</h3>
        <ul class="space-y-2 text-xs mb-6">
          <li>
            <a data-content="footer-email" href="mailto:info@flexone.pe" class="hover:text-brand-cyan transition-colors">info@flexone.pe</a>
          </li>
          <li data-content="footer-address" class="text-white/60">Lima, Perú</li>
          <li>
            <a data-content="footer-phone" href="https://wa.me/51955479055" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline">
              +51 955 479 055
            </a>
          </li>
        </ul>

        <!-- Redes Sociales -->
        <div class="flex items-center gap-3 text-white/70">
          <a href="https://www.linkedin.com/company/flexonepe" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded bg-white/5 hover:bg-white/10 hover:text-white flex items-center justify-center transition-colors" aria-label="LinkedIn">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          </a>
          <a href="https://facebook.com/flexonepe" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded bg-white/5 hover:bg-white/10 hover:text-white flex items-center justify-center transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02z"/></svg>
          </a>
          <a href="https://instagram.com/flexonepe" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded bg-white/5 hover:bg-white/10 hover:text-white flex items-center justify-center transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://youtube.com/@flexonepe" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded bg-white/5 hover:bg-white/10 hover:text-white flex items-center justify-center transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Barra Inferior -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50">
      <p data-content="footer-copyright">© {currentYear} Flexone. Implementadores de Odoo en el Perú.</p>
      <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
    </div>
  </div>
</footer>
