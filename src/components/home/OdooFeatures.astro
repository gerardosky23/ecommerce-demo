---
const features = [
  {
    title: 'Ecosistema Totalmente Integrado',
    desc: 'Olvídate de conectar sistemas dispersos mediante hojas de cálculo. Ventas, compras, inventario, facturación y planillas se comunican en tiempo real en una sola base de datos.',
    icon: 'layers'
  },
  {
    title: 'Localización Peruana Integral',
    desc: 'Adaptación completa a la normativa de la SUNAT, Ministerio de Trabajo y entidades financieras locales. Facturación electrónica UBL 2.1, SIRE y detracciones nativas.',
    icon: 'shield'
  },
  {
    title: 'Crecimiento Modular Sin Ataduras',
    desc: 'Comienza con los módulos prioritarios (ej. Contabilidad y Facturación) y activa más funciones (Manufactura, CRM, POS) a medida que tu empresa lo requiera, sin reestructuraciones.',
    icon: 'rocket'
  },
  {
    title: 'Sin Costos Ocultos por Usuario',
    desc: 'Modelo de licenciamiento transparente y predecible, con la posibilidad de desplegar en nube privada (On-Premise) o en la infraestructura oficial Odoo.sh.',
    icon: 'cpu'
  },
  {
    title: 'Multi-Moneda & Tipo de Cambio SUNAT',
    desc: 'Manejo natural de transacciones en Soles (PEN) y Dólares (USD), con actualización automática del tipo de cambio diario oficial de la SUNAT o SBS.',
    icon: 'chart'
  },
  {
    title: 'Acceso Seguro Web & App Móvil',
    desc: 'Accede a la plataforma desde cualquier navegador, tablet o smartphone con controles estrictos de seguridad, roles por usuario y doble factor de autenticación (2FA).',
    icon: 'clock'
  }
];
---

<section class="py-24 px-4 sm:px-6 lg:px-8 bg-surface-card/20 border-y border-white/5">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-purple/15 border border-brand-purple/30 text-xs font-semibold text-purple-300 mb-4">
        ¿Por qué elegir Odoo ERP con Flexone?
      </div>
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight mb-4">
        Tecnología de clase mundial adaptada a las leyes peruanas
      </h2>
      <p class="text-ink-muted text-base leading-relaxed">
        Odoo es el ERP más moderno y versátil del mundo, con más de 12 millones de usuarios. Flexone garantiza su implementación precisa y sin fricciones en el Perú.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((f) => (
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-brand-purple/40 hover:bg-white/[0.04] transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-brand-purple/10 border border-brand-purple/20 flex items-center justify-center text-purple-400 mb-5">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg text-white mb-2">{f.title}</h3>
          <p class="text-ink-muted text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
