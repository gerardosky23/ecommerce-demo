---
const odooBenefits = [
  {
    title: 'Es de código abierto',
    desc: 'Para crear esta tecnología colaboramos con una comunidad de más de 100,000 desarrolladores de todo el mundo, garantizando innovación continua sin quedar atado a un código cerrado.',
    img: '/secciones/por-que-odoo.webp'
  },
  {
    title: 'Precios competitivos',
    desc: 'Sin precios basados en uso, sin venta de funciones adicionales por separado, sin contratos a largo plazo ni cobros sorpresa al crecer.',
    img: '/secciones/precios-odoo.webp'
  },
  {
    title: 'Comunidad en todo el mundo',
    desc: 'Odoo tiene una comunidad activa de más de 12 millones de usuarios en todo el mundo, con miles de módulos comprobados y documentación técnica abierta.',
    img: '/secciones/comunidad-odoo.webp'
  }
];
---

<section class="py-24 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-brand-dark tracking-tight mb-4">
        ¿Por qué <span class="font-normal text-brand-magenta">Odoo</span> es el mejor ERP para tu empresa?
      </h2>
      <p class="text-brand-muted text-base sm:text-lg leading-relaxed font-light">
        Odoo es la solución ERP más completa, flexible y moderna del mercado. Diseñado para adaptarse a cualquier tipo de negocio, te permite centralizar todas tus operaciones en un solo sistema, mejorando la eficiencia y el crecimiento empresarial.
      </p>
    </div>

    <!-- 3 Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {odooBenefits.map((item) => (
        <article class="p-8 rounded-2xl bg-neutral-50 border border-brand-border flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="mb-6 rounded-xl overflow-hidden bg-white border border-brand-border p-2">
              <img
                src={item.img}
                alt={item.title}
                width="300"
                height="180"
                class="w-full h-40 object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-medium text-brand-dark mb-3">{item.title}</h3>
            <p class="text-brand-muted text-sm leading-relaxed font-light">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom link -->
    <div class="text-center">
      <a
        href="/contacto"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-magenta hover:underline"
      >
        <span>¿Dudas sobre Odoo para tu empresa? Hablemos</span>
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>
