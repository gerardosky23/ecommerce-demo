---
---

<section id="soluciones" class="py-20 lg:py-24 px-4 sm:px-6 lg:px-8 bg-white text-brand-dark">
  <div class="max-w-[1300px] mx-auto">
    <!-- Header matching flexone.pe -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-brand-dark tracking-tight mb-4 leading-tight">
        Odoo, implementado para la <span class="font-normal text-brand-magenta">empresa peruana</span>
      </h2>
      <p class="text-neutral-600 text-sm sm:text-base leading-relaxed font-light">
        Odoo reúne ventas, compras, inventario, contabilidad, planillas y más en un solo sistema. Flexone lo implementa con la localización peruana completa y lo ajusta a la forma de trabajar de cada empresa.
      </p>
    </div>

    <!-- 2-Column Bento Grid matching exact flexone.pe architecture -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      <!-- Left Column (4 cols on xl): Localización peruana completa -->
      <div class="xl:col-span-4 flex flex-col">
        <div class="h-full rounded-2xl border border-neutral-200/80 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
          <div>
            <!-- Icon SVG from flexone.pe -->
            <figure class="text-brand-magenta mb-4">
              <svg width="46" height="46" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.74136 18.8326C9.60765 18.6411 9.54079 18.5453 9.48641 18.4446C9.36533 18.2205 9.2882 17.9753 9.25914 17.7222C9.24609 17.6085 9.24609 17.4917 9.24609 17.2582V14.1914H14.7461V17.2582C14.7461 19.1702 14.7461 20.1262 14.5249 20.5566C14.0158 21.5471 12.7956 21.931 11.8111 21.4103C11.3833 21.1841 10.836 20.4002 9.74136 18.8326Z" fill="currentColor" />
                <path d="M17.5114 9.84101C19.375 6.88684 20.3067 5.40976 19.9484 4.21191C19.8359 3.83574 19.6441 3.48802 19.386 3.19214C18.5641 2.25 16.8176 2.25 13.3248 2.25H10.6405C7.12482 2.25 5.36697 2.25 4.54466 3.1974C4.28652 3.49482 4.09526 3.84421 3.98384 4.22194C3.6289 5.42518 4.57619 6.90596 6.47077 9.86751L9.23438 14.1875H14.7695L17.5114 9.84101Z" fill="currentColor" fill-opacity="0.25" />
              </svg>
            </figure>
            <h3 class="text-xl sm:text-2xl font-semibold text-brand-dark mb-3 tracking-tight">
              Localización peruana completa
            </h3>
            <p class="text-neutral-600 text-sm sm:text-[15px] leading-relaxed mb-6 font-light">
              Contabilidad, facturación electrónica, kardex y planillas con la normativa peruana, probadas en empresas reales.
            </p>
            <a
              href="#localizacion"
              class="inline-flex items-center px-5 py-2.5 rounded-lg bg-[#191b1d] text-white text-xs font-semibold hover:bg-black transition-colors"
            >
              Ver localización
            </a>
          </div>

          <!-- Bottom image -->
          <div class="mt-6 pt-2">
            <img
              src="/secciones/modulos-contabilidad.webp"
              alt="Contabilidad de Odoo conectada con Ventas, Compra, Inventario, Punto de venta, Gastos y Nómina"
              width="706"
              height="609"
              class="w-full h-auto rounded-xl object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <!-- Right Column (8 cols on xl): Operaciones conectadas + 2 bottom cards -->
      <div class="xl:col-span-8 flex flex-col gap-6 lg:gap-8 justify-between">
        <!-- Top Full Card: Operaciones conectadas -->
        <div class="rounded-2xl bg-[#d6275c]/[0.08] border border-[#d6275c]/15 p-6 sm:p-8 overflow-hidden shadow-sm">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            <div class="md:col-span-6">
              <!-- Connected Icon SVG -->
              <figure class="text-brand-magenta mb-4">
                <svg width="46" height="46" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 2.25C8.20507 2.25 6.75 3.70507 6.75 5.5V6.25H13.25V5.5C13.25 3.70507 11.7949 2.25 10 2.25Z" fill="currentColor" />
                  <path d="M17.75 17.25H18.5C20.2949 17.25 21.75 15.7949 21.75 14C21.75 12.2051 20.2949 10.75 18.5 10.75H17.75V17.25Z" fill="currentColor" />
                  <path d="M4.5 12.25C5.4665 12.25 6.25 13.0335 6.25 14C6.25 14.9665 5.4665 15.75 4.5 15.75H3.53571C3.03452 15.75 2.78393 15.75 2.60098 15.865C2.50557 15.9249 2.4249 16.0056 2.36496 16.101C2.25 16.2839 2.25 16.5345 2.25 17.0357C2.25 18.8734 2.25 19.7923 2.67151 20.4631C2.89131 20.8129 3.1871 21.1087 3.53691 21.3285C4.20774 21.75 5.12659 21.75 6.96429 21.75C7.46548 21.75 7.71607 21.75 7.89903 21.635C7.99443 21.5751 8.0751 21.4944 8.13505 21.399C8.25 21.2161 8.25 20.9655 8.25 20.4643L8.25 19.5C8.25 18.5335 9.0335 17.75 10 17.75C10.9665 17.75 11.75 18.5335 11.75 19.5V20.4643C11.75 20.9655 11.75 21.2161 11.865 21.399C11.9249 21.4944 12.0056 21.5751 12.101 21.635C12.2839 21.75 12.5345 21.75 13.0357 21.75H13.25C14.8846 21.75 15.7019 21.75 16.3179 21.4136C16.7806 21.161 17.161 20.7806 17.4136 20.3179C17.75 19.7019 17.75 18.8846 17.75 17.25V10.75C17.75 9.1154 17.75 8.2981 17.4136 7.68207C17.161 7.21936 16.7806 6.83904 16.3179 6.58638C15.7019 6.25 14.8846 6.25 13.25 6.25H6.75C5.1154 6.25 4.2981 6.25 3.68206 6.58638C3.21936 6.83904 2.83904 7.21936 2.58638 7.68206C2.25 8.2981 2.25 9.1154 2.25 10.75V10.9643C2.25 11.4655 2.25 11.7161 2.36496 11.899C2.4249 11.9944 2.50557 12.0751 2.60098 12.135C2.78393 12.25 3.03452 12.25 3.53572 12.25H4.5Z" fill="currentColor" fill-opacity="0.25" />
                </svg>
              </figure>
              <h3 class="text-xl sm:text-2xl font-semibold text-brand-dark mb-3 tracking-tight">
                Operaciones conectadas
              </h3>
              <p class="text-neutral-600 text-sm sm:text-[15px] leading-relaxed mb-6 font-light">
                Lo que registra ventas ya lo ve almacén, y lo que compra almacén llega solo a contabilidad. Sin reprocesos ni Excel de por medio.
              </p>
              <a
                href="#soluciones"
                class="inline-flex items-center px-5 py-2.5 rounded-lg border border-brand-magenta text-brand-magenta text-xs font-semibold hover:bg-brand-magenta hover:text-white transition-colors"
              >
                Explora los módulos
              </a>
            </div>

            <div class="md:col-span-6 flex justify-end">
              <div class="rounded-xl overflow-hidden border-4 border-[#191b1d] shadow-xl max-w-full">
                <img
                  src="/secciones/apps-odoo.webp"
                  alt="Menú de aplicaciones de Odoo con sus módulos"
                  width="800"
                  height="500"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Row: 2 Cards side by side -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-stretch flex-1">
          <!-- Card 1: Dark Card with geometric watermark -->
          <div class="rounded-2xl bg-[#191b1d] text-white p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden shadow-xl min-h-[220px]">
            <!-- Decorative corner SVG -->
            <div class="absolute -bottom-6 -right-6 w-44 h-44 text-white/[0.04] pointer-events-none">
              <svg class="w-full h-full fill-current" viewBox="0 0 220 209">
                <circle cx="110" cy="105" r="90" stroke="currentColor" stroke-width="6" fill="none" />
                <path d="M50 105 L170 105 M110 45 L110 165" stroke="currentColor" stroke-width="4" />
                <circle cx="110" cy="105" r="50" stroke="currentColor" stroke-width="4" fill="none" />
              </svg>
            </div>

            <div class="relative z-10">
              <h3 class="text-xl sm:text-2xl font-light text-white mb-6 leading-snug">
                ¿Quieres ver cómo quedaría Odoo en tu empresa?
              </h3>
            </div>

            <div class="relative z-10 pt-4">
              <a
                href="/contacto"
                class="inline-flex items-center px-5 py-2.5 rounded-lg bg-white text-[#191b1d] text-xs font-semibold hover:bg-neutral-100 transition-colors shadow-md"
              >
                Separa tu demo
              </a>
            </div>
          </div>

          <!-- Card 2: Light Card (Crece sin reconfigurar todo) -->
          <div class="rounded-2xl bg-[#f8f9fa] border border-neutral-200/80 p-6 sm:p-8 flex flex-col justify-between shadow-sm min-h-[220px]">
            <div>
              <!-- Stack/Cubes SVG Icon -->
              <figure class="text-brand-magenta mb-4">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.95 9.83377C3.51099 9.1789 2.79149 8.85147 2.55187 8.40828C2.3112 7.96313 2.3112 7.42663 2.55187 6.98148C2.79149 6.53829 3.51099 6.21086 4.95 5.55599L10.8816 2.8566C11.37 2.63435 11.6142 2.52322 11.872 2.50115C11.9572 2.49386 12.0428 2.49386 12.128 2.50115C12.3858 2.52322 12.63 2.63435 13.1184 2.8566L19.05 5.55599C20.489 6.21086 21.2085 6.53829 21.4481 6.98148C21.6888 7.42663 21.6888 7.96313 21.4481 8.40828C21.2085 8.85147 20.489 9.1789 19.05 9.83377L13.1184 12.5332C12.63 12.7554 12.3858 12.8665 12.128 12.8886C12.0428 12.8959 11.9572 12.8959 11.872 12.8886C11.6142 12.8665 11.37 12.7554 10.8816 12.5332L4.95 9.83377Z" fill="currentColor" fill-opacity="0.25" />
                  <path d="M4.95 14.1115C3.51099 14.7664 2.79149 15.0938 2.55187 15.537C2.3112 15.9822 2.3112 16.5187 2.55187 16.9638C2.79149 17.407 3.51099 17.7345 4.95 18.3893L10.8816 21.0887C11.37 21.311 11.6142 21.4221 11.872 21.4442C11.9572 21.4515 12.0428 21.4515 12.128 21.4442C12.3858 21.4221 12.63 21.311 13.1184 21.0887L19.05 18.3893C20.489 17.7345 21.2085 17.407 21.4481 16.9638C21.6888 16.5187 21.6888 15.9822 21.4481 15.537C21.2085 15.0938 20.489 14.7664 19.05 14.1115L13.1184 16.8109C12.63 17.0332 12.3858 17.1443 12.128 17.1664C12.0428 17.1737 11.9572 17.1737 11.872 17.1664C11.6142 17.1443 11.37 17.0332 10.8816 16.8109L4.95 14.1115Z" fill="currentColor" fill-opacity="0.25" />
                  <path d="M6 10.2734L10.8827 12.4929C11.3707 12.7146 11.6146 12.8255 11.8722 12.8476C11.9572 12.8548 12.0428 12.8548 12.1278 12.8476C12.3854 12.8255 12.6293 12.7146 13.1173 12.4929L18 10.2734M6 14.2734L10.8827 16.4929C11.3707 16.7146 11.6146 16.8255 11.8722 16.8476C11.9572 16.8548 12.0428 16.8548 12.1278 16.8476C12.3854 16.8255 12.6293 16.7146 13.1173 16.4929L18 14.2734" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </figure>

              <h3 class="text-xl sm:text-2xl font-semibold text-brand-dark mb-3 tracking-tight">
                Crece sin reconfigurar todo
              </h3>
              <p class="text-neutral-600 text-sm sm:text-[15px] leading-relaxed font-light mb-6">
                Empiezas por lo urgente y activas el siguiente módulo cuando lo necesitas, sobre la misma base.
              </p>
            </div>

            <div class="pt-4">
              <a
                href="#a-medida"
                class="inline-flex items-center px-5 py-2.5 rounded-lg bg-brand-magenta text-white text-xs font-semibold hover:bg-[#b81d4c] transition-colors shadow-sm"
              >
                A tu medida
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
